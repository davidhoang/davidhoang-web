# Jev via Vercel AI Gateway (preferred)
# On Vercel this is injected automatically. For local development, run:
#   vercel link
#   vercel env pull .env.local
VERCEL_OIDC_TOKEN=

# Optional static Gateway credential for non-Vercel environments.
AI_GATEWAY_API_KEY=

# Direct TypeSafe fallback for local development. TYPESAFE_API_KEY is also accepted.
TYPESAFE_AI_API_KEY=

# Existing theme generation and theme explorer integration.
ANTHROPIC_API_KEY=

# Optional comments host override.
PUBLIC_COMMENTS_ORIGIN=
