---
import PageSocialMeta from '../components/PageSocialMeta.astro';
import { absoluteUrl, CANONICAL_SITE } from '../utils/structuredData';
import { buildOgImageUrl } from '../utils/ogImage';

interface Props {
  title: string;
  description?: string;
  fonts?: string;
  /** Value for `<meta name="robots">` (e.g. `noindex, nofollow` for utility routes). */
  robots?: string;
}

const { title, description, fonts, robots } = Astro.props;

// Prototypes previously shipped no social meta, so shares rendered blank.
// Give them a canonical URL and an on-brand generated OG card.
const pathname = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, '');
const canonicalUrl = Astro.site ? absoluteUrl(pathname, Astro.site.toString()) : `${CANONICAL_SITE}${pathname}`;
const ogImageUrl = absoluteUrl(
  buildOgImageUrl({ title, description, type: 'page' }),
  Astro.site ? Astro.site.toString() : CANONICAL_SITE,
);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <PageSocialMeta
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      ogImageUrl={ogImageUrl}
      robots={robots}
    />
    {
      fonts && (
        <>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link href={fonts} rel="stylesheet" />
        </>
      )
    }
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
