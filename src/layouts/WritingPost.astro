---
import WritingLayout from './WritingLayout.astro';
import BlogMeta from '../components/BlogMeta.astro';
import { Image } from 'astro:assets';
import SidebarWriting from '../components/SidebarWriting.astro';
import CommentsSection from '../components/CommentsSection.astro';
import RelatedContentSection from '../components/RelatedContentSection.astro';
import CompanionPrototype from '../components/CompanionPrototype.astro';
import ShareControls from '../components/ShareControls.astro';
import { formatLongDate } from '../utils/formatDate';
import { resolveAssetImage } from '../utils/assetImages';
import {
  absoluteUrl,
  buildBlogPostingJsonLd,
  buildBreadcrumbListJsonLd,
  CANONICAL_SITE,
  toIsoDate,
} from '../utils/structuredData';
import '../styles/pages/writing-post.css';

const { data, relatedContent = [], headings = [], readingTime } = Astro.props;
const tocHeadings = headings.filter((h: { depth: number }) => h.depth >= 1 && h.depth <= 3);

const blogContent = {
  forwards: {
    old: { name: 'contentFadeOut', duration: '0.15s', easing: 'ease-in', fillMode: 'forwards' },
    new: { name: 'blogSlideIn', duration: '0.4s', delay: '0.08s', easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fillMode: 'backwards' },
  },
  backwards: {
    old: { name: 'blogSlideOut', duration: '0.2s', easing: 'ease-in', fillMode: 'forwards' },
    new: { name: 'contentSlideBack', duration: '0.35s', delay: '0.05s', easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fillMode: 'backwards' },
  },
};

const { title, description, pubDate, tags } = data;
const slug = Astro.url.pathname.split('/').filter(Boolean).pop();

const coverImage = data.coverImage;
const coverAsset = resolveAssetImage(coverImage);

const pageDescription = description || 'An article by David Hoang on design, engineering, AI, and entrepreneurship.';
const ogImage = data.ogImage || coverImage || `/api/og?title=${encodeURIComponent(title)}&description=${encodeURIComponent(pageDescription)}&type=writing`;

const pathname = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, '');
const canonicalUrl = absoluteUrl(pathname);
const markdownUrl = data.draft ? undefined : `${pathname}.md`;
const ogImageUrl = absoluteUrl(ogImage);
const isoDate = toIsoDate(pubDate);
const publishDate = pubDate instanceof Date ? pubDate : new Date(pubDate);

const articleJsonLd = buildBlogPostingJsonLd({
  title,
  description: pageDescription,
  canonicalUrl,
  datePublished: publishDate,
  // Writing collection has no updatedDate — do not invent a fresher modification time.
  dateModified: publishDate,
  imageUrl: ogImageUrl,
  tags,
});

const breadcrumbJsonLd = buildBreadcrumbListJsonLd([
  { name: 'Home', item: CANONICAL_SITE },
  { name: 'Writing', item: absoluteUrl('/writing') },
  { name: title, item: canonicalUrl },
]);
---

<WritingLayout title={title} description={pageDescription} ogImage={ogImage} disableContentMoodFilter>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  {markdownUrl && (
    <link slot="head" rel="alternate" type="text/markdown" title="Markdown" href={markdownUrl} />
  )}
  <BlogMeta slot="head" ogImage={ogImage} publishDate={publishDate} tags={tags} />

  <article class="writing-post" data-has-toc={tocHeadings.length > 0 ? '' : undefined} transition:animate={blogContent}>
    {coverImage && (
      <div class="writing-post__hero layout-breakout">
        {coverAsset ? (
          <Image
            src={coverAsset}
            alt={title}
            loading="eager"
            decoding="async"
            fetchpriority="high"
            widths={[800, 1200, 1800, 2400]}
            sizes="100vw"
          />
        ) : (
          <img
            src={coverImage}
            alt={title}
            loading="eager"
            decoding="async"
            fetchpriority="high"
            width="1200"
            height="630"
          />
        )}
      </div>
    )}

    <header class="writing-post__header">
      <a href="/writing" class="text-eyebrow text-eyebrow--link link-plain">Writing</a>
      <h1 class="writing-post__title" transition:name={`title-${slug}`}>{title}</h1>
      {description && <p class="writing-post__deck">{description}</p>}
      <div class="writing-post__meta">
        <div class="writing-post__meta-info">
          <time datetime={isoDate}>{formatLongDate(publishDate)}</time>
          {readingTime && (
            <span aria-label={`Estimated reading time: ${readingTime}`}>{readingTime}</span>
          )}
        </div>
        <ShareControls url={canonicalUrl} title={title} description={pageDescription} />
      </div>
    </header>

    <div class="writing-post__grid">
      {tocHeadings.length > 0 && <SidebarWriting headings={headings} variant="toc-left" />}
      <div class="writing-post__main">
        {data.companionPrototype && <CompanionPrototype slug={data.companionPrototype} />}
        <div class="prose-content writing-post__prose">
          <slot />
        </div>
        {tags && tags.length > 0 && (
          <ul class="writing-post__tags" aria-label="Tags">
            {tags.map((tag: string) => (
              <li class="writing-post__tag text-eyebrow">{tag}</li>
            ))}
          </ul>
        )}
        <RelatedContentSection items={relatedContent} heading="Keep reading" />
        <CommentsSection />
      </div>
      <SidebarWriting variant="meta-sidebar" />
    </div>
  </article>

  <button class="back-to-top" aria-label="Back to top" id="back-to-top">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M8 3L3 8.5M8 3l5 5.5M8 3v10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <script>
    function initBackToTop() {
      const btn = document.getElementById('back-to-top');
      if (!btn) return;

      let visible = false;
      const toggle = () => {
        const show = window.scrollY > 400;
        if (show !== visible) {
          visible = show;
          btn.classList.toggle('visible', show);
        }
      };

      window.addEventListener('scroll', toggle, { passive: true });
      toggle();

      btn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    initBackToTop();
    document.addEventListener('astro:after-swap', initBackToTop);
  </script>
</WritingLayout>
