---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import SubstackSignup from '../components/SubstackSignup.astro';
import PageHeader from '../components/PageHeader.astro';
import { proofOfConcept } from '../data/proofOfConcept';
import { buildSubscribePageJsonLd } from '../utils/structuredData';

const ogImage = '/images/highlights/img-highlights-proof-of-concept.webp';
const writing = await getCollection('writing', ({ data }) => !data.draft);
const readingPath = [
  {
    id: 'operator-mode',
    pillar: 'Lead',
    note: 'Lead through craft, fill founder gaps, and scale the company’s culture.',
  },
  {
    id: 'building-your-designs',
    pillar: 'Build',
    note: 'Turn ideas into working prototypes that expose trade-offs and improve product decisions.',
  },
  {
    id: 'designs-seat-at-the-cap-table-part-i',
    pillar: 'Business',
    note: 'Bring design judgment into startup strategy, ownership, and investing.',
  },
].map((item) => {
  const post = writing.find((entry) => entry.id === item.id);
  if (!post) throw new Error(`Missing published Design GM reading: ${item.id}`);
  return { ...item, title: post.data.title, href: `/writing/${post.id}` };
});
---

<MainLayout title={proofOfConcept.title} description={proofOfConcept.description} ogImage={ogImage}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(buildSubscribePageJsonLd())} />
  <PageHeader
    title={proofOfConcept.name}
    image="/images/header-images/img-header-subscribe.webp"
    alt="Subscribe to Proof of Concept"
    class="subscribe-hero"
    priority={true}
  />
  <div class="content-page content-page--compact-top subscribe-page container-narrow">
    <section class="content-page__intro">
      <h2 class="subscribe-page__title">{proofOfConcept.name}</h2>
      <p class="subscribe-page__lead">{proofOfConcept.introduction}</p>
    </section>

    <section class="card subscribe-cta" id="newsletter" aria-labelledby="subscribe-form-title">
      <h2 class="content-page__section-title" id="subscribe-form-title">Delivered every Sunday</h2>
      <p class="subscribe-cta__hint text-muted">Email newsletters are always free.</p>
      <SubstackSignup showTitle={false} description="" compact />
    </section>

    <section class="content-page__section" aria-labelledby="design-gm-heading">
      <h2 id="design-gm-heading">What is a Design GM?</h2>
      <p>{proofOfConcept.definition}</p>
      <p>
        Each Sunday, I write about the judgment, systems, and experiments behind shipping real products —
        from taste and craft to ecosystems, agents, and running design as a business.
      </p>
    </section>

    <section class="content-page__section" aria-labelledby="reading-heading">
      <h2 id="reading-heading">Start with these essays</h2>
      <ul class="content-page__list content-page__list--linked subscribe-reading">
        {
          readingPath.map((item) => (
            <li>
              <span class="text-eyebrow">{item.pillar}</span>
              <a href={item.href}>{item.title}</a>
              <span class="content-page__list-note">{item.note}</span>
            </li>
          ))
        }
      </ul>
      <p class="subscribe-more">
        <a href="/writing">Explore all writing</a>
      </p>
    </section>

    <section class="content-page__section" aria-labelledby="author-heading">
      <h2 id="author-heading">Who writes Proof of Concept?</h2>
      <p>{proofOfConcept.authorDescription}</p>
      <p>
        Proof of Concept is where I work through what it means to lead, build, and experiment like an
        owner. <a href="/about">More about David</a>.
      </p>
      <a href="#newsletter" class="btn btn-primary subscribe-author-cta">Get the Sunday letter</a>
    </section>
  </div>
</MainLayout>

<style>
  :global(.subscribe-hero) {
    --hero-height: 32vh;
    --hero-height-mobile: 28vh;
    --section-spacing: var(--spacing-xl);
  }

  .subscribe-page .content-page__intro {
    margin-bottom: var(--spacing-xl);
  }

  .subscribe-page__title {
    margin: 0 0 var(--spacing-md);
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: var(--heading-weight, 600);
    line-height: 1.25;
    letter-spacing: var(--heading-letter-spacing, -0.02em);
    color: var(--color-text);
    max-width: 22ch;
  }

  .subscribe-page__lead {
    margin: 0;
    max-width: 52ch;
    font-size: var(--prose-size);
    line-height: var(--prose-line-height, 1.65);
    letter-spacing: var(--letter-spacing-body);
    color: var(--color-muted);
  }

  .subscribe-cta {
    margin-bottom: var(--spacing-2xl);
    scroll-margin-top: calc(var(--content-top-padding, 6rem) + var(--spacing-sm));
  }

  .subscribe-cta__hint {
    margin: 0 0 var(--spacing-lg);
    font-size: var(--body-size);
    line-height: var(--body-line-height);
    max-width: 46ch;
  }

  .subscribe-cta :global(.substack-signup) {
    border-top: none;
    padding: 0;
  }

  .subscribe-page .content-page__section > p {
    margin: 0;
    max-width: 52ch;
    font-size: var(--body-size);
    line-height: var(--body-line-height);
    letter-spacing: var(--letter-spacing-body);
    color: var(--color-text);
  }

  .subscribe-page .content-page__section > p + p {
    margin-top: var(--spacing-md);
  }

  .subscribe-reading .text-eyebrow {
    display: block;
    margin: 0 0 var(--spacing-xs);
  }

  .subscribe-more {
    margin: var(--spacing-lg) 0 0;
    font-size: var(--body-size);
  }

  .subscribe-more a,
  .subscribe-page .content-page__section a:not(.btn) {
    color: var(--color-link);
    font-weight: 600;
  }

  .subscribe-author-cta {
    margin-top: var(--spacing-lg);
    font-weight: 600;
  }

  .subscribe-author-cta::after {
    display: none;
  }

  @media (max-width: 768px) {
    .subscribe-page__title {
      max-width: none;
    }

    .subscribe-cta {
      margin-bottom: var(--spacing-xl);
    }

    .subscribe-author-cta {
      width: 100%;
    }
  }
</style>
