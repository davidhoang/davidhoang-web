---
import MainLayout from '../layouts/MainLayout.astro';
import SubstackSignup from '../components/SubstackSignup.astro';
import PageHeader from '../components/PageHeader.astro';
import ProofOfConceptIssueCanvas from '../components/subscribe/ProofOfConceptIssueCanvas';
import { getProofOfConceptIssuesArchive } from '../utils/proofOfConceptIssues';

const pageDescription =
  'Proof of Concept — weekly newsletter on design, technology, and entrepreneurship. Free every Sunday.';
const ogImage = '/images/highlights/img-highlights-proof-of-concept.webp';
const pocArchive = getProofOfConceptIssuesArchive();
---

<MainLayout title="Subscribe" description={pageDescription} ogImage={ogImage}>
  <PageHeader
    title="Subscribe"
    image="/images/header-images/img-header-subscribe.webp"
    alt="Subscribe to Proof of Concept"
  />
  <div class="container container-narrow subscribe-page">
    <div class="subscribe-page__stack">
      <header class="subscribe-page__intro">
        <p class="subscribe-page__eyebrow">Proof of Concept</p>
        <h2 class="subscribe-page__title">Weekly notes on design, tech, and building</h2>
        <p class="subscribe-page__lead">Free every Sunday.</p>
      </header>
      {pocArchive.count > 0 && (
        <section class="subscribe-poc-canvas" aria-labelledby="subscribe-poc-canvas-title">
          <div class="subscribe-poc-canvas__copy">
            <h3 class="subscribe-poc-canvas__title" id="subscribe-poc-canvas-title">
              Illustrated issues
            </h3>
            <p class="subscribe-poc-canvas__lede">
              {pocArchive.count} recent Proof of Concept posts with cover art — drag or scroll the canvas, then
              tap a cover to read on Substack.
            </p>
          </div>
          <div class="subscribe-poc-canvas__stage">
            <ProofOfConceptIssueCanvas client:visible archive={pocArchive} />
          </div>
        </section>
      )}
      <section class="subscribe-page__panel" aria-labelledby="subscribe-form-title">
        <h3 class="subscribe-page__panel-title" id="subscribe-form-title">Email</h3>
        <SubstackSignup showTitle={false} description="" compact />
      </section>
    </div>
  </div>
</MainLayout>

<style>
  .subscribe-page {
    padding-bottom: clamp(3rem, 8vw, 5rem);
  }
  .subscribe-page__stack {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 3rem);
  }
  .subscribe-page__intro {
    padding-top: 0.25rem;
  }
  .subscribe-page__eyebrow {
    margin: 0 0 var(--spacing-sm);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .subscribe-page__title {
    margin: 0 0 var(--spacing-md);
    font-size: clamp(1.35rem, 2.8vw, 1.75rem);
    font-weight: var(--heading-weight, 600);
    line-height: 1.25;
    letter-spacing: var(--heading-letter-spacing, -0.02em);
    color: var(--color-text);
    max-width: 28ch;
  }
  .subscribe-page__lead {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-muted);
    max-width: 52ch;
  }
  .subscribe-page__panel {
    background: var(--color-card-bg, var(--color-bg));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg, 12px);
    padding: clamp(1.5rem, 4vw, 2.25rem);
    box-shadow: var(--card-shadow, 0 1px 0 color-mix(in srgb, var(--color-text) 6%, transparent));
  }
  .subscribe-page__panel-title {
    margin: 0 0 calc(var(--spacing-xs) + 0.1rem);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .subscribe-page__panel-hint {
    margin: 0 0 var(--spacing-lg);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-muted);
    max-width: 42ch;
  }
  /* Form block: no top rule inside the card; compact variant already scales type */
  .subscribe-page__panel :global(.substack-signup) {
    border-top: none;
    padding: 0;
  }
  .subscribe-poc-canvas {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    margin-inline: calc(50% - 50vw);
    width: 100vw;
    max-width: 100vw;
    padding-inline: max(var(--spacing-sm), env(safe-area-inset-left, 0px))
      max(var(--spacing-sm), env(safe-area-inset-right, 0px));
  }
  .subscribe-poc-canvas__copy {
    max-width: var(--container-narrow, 42rem);
    margin-inline: auto;
    padding-inline: var(--spacing-sm);
  }
  .subscribe-poc-canvas__title {
    margin: 0 0 var(--spacing-xs);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .subscribe-poc-canvas__lede {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-muted);
    max-width: 52ch;
  }
  .subscribe-poc-canvas__stage {
    position: relative;
    height: clamp(22rem, 62vh, 40rem);
    border-block: 1px solid var(--color-border);
    background: var(--color-bg);
    overflow: hidden;
  }
  .subscribe-poc-canvas__stage :global(.poc-infinite-grid section) {
    background-color: var(--color-bg) !important;
    cursor: grab;
  }
  .subscribe-poc-canvas__stage :global(.poc-infinite-grid .font-mono) {
    font-family: var(--font-body, inherit);
    text-transform: none;
    letter-spacing: normal;
    color: var(--color-text);
  }
  .subscribe-poc-canvas__stage :global(.poc-infinite-grid .text-neutral-400) {
    color: var(--color-muted);
  }
  .subscribe-poc-canvas__stage :global(.poc-canvas-empty) {
    margin: 0;
    padding: var(--spacing-lg);
    text-align: center;
    color: var(--color-muted);
  }
  @media (max-width: 480px) {
    .subscribe-page__title {
      max-width: none;
    }
  }
</style>