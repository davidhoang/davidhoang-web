---
import MainLayout from '../layouts/MainLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { blogroll } from '../data/blogroll';

const pageDescription =
  'A blogroll of sites I read — the old WordPress habit of listing the people whose work I keep coming back to.';
const headerImage = '/images/header-images/img-header-writing.webp';

function siteHost(url: string): string {
  return new URL(url).host.replace(/^www\./, '');
}
---

<MainLayout title="Blogroll | David Hoang" description={pageDescription}>
  <PageHeader
    title="Blogroll"
    image={headerImage}
    alt="Blogroll"
    priority={true}
  />
  <div class="content-page content-page--compact-top container-narrow">
    <section class="content-page__intro">
      <p>
        WordPress used to keep a blogroll in the sidebar: the other sites you actually read, named
        and linked. This is that list.
      </p>
    </section>

    <ul class="blogroll" aria-label="Blogroll">
      {
        blogroll.map((entry) => (
          <li class="blogroll-item">
            <a class="blogroll-link" href={entry.url} target="_blank" rel="noopener noreferrer">
              <span class="blogroll-name">{entry.name}</span>
              <span class="blogroll-host">
                {siteHost(entry.url)}
                <span class="blogroll-external" aria-hidden="true">↗</span>
              </span>
              <span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</MainLayout>

<style>
  .blogroll {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .blogroll-item {
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--color-border);
  }

  .blogroll-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: var(--spacing-lg);
    padding-block: var(--spacing-md);
    border-bottom: none;
    color: inherit;
    text-decoration: none;
  }

  .blogroll-link::before,
  .blogroll-link::after {
    content: none;
    display: none;
  }

  .blogroll-name,
  .blogroll-host,
  .blogroll-external {
    font-size: var(--body-size);
    font-weight: var(--body-weight);
    line-height: var(--body-line-height);
    letter-spacing: var(--letter-spacing-body);
  }

  .blogroll-name {
    color: var(--color-text);
  }

  .blogroll-host {
    display: inline-flex;
    align-items: baseline;
    justify-self: end;
    gap: var(--spacing-xs);
    color: var(--color-muted);
    white-space: nowrap;
    border-bottom: 1px dotted var(--color-muted);
  }

  .blogroll-external {
    color: var(--color-link);
    line-height: 1;
  }

  @media (hover: hover) {
    .blogroll-link:hover .blogroll-name,
    .blogroll-link:hover .blogroll-host,
    .blogroll-link:hover .blogroll-external {
      color: var(--color-link-hover);
    }

    .blogroll-link:hover .blogroll-host {
      border-bottom-color: transparent;
    }
  }
</style>
