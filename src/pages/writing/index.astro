---
import WritingLayout from '../../layouts/WritingLayout.astro';
import { getCollection } from 'astro:content';
import WritingGraph from '../../components/WritingGraph.astro';
import { buildGraph } from '../../utils/writingGraph';
import ContentIndexCard from '../../components/ContentIndexCard.astro';
import WritingDefaultCover from '../../components/WritingDefaultCover.astro';
import { formatListDate } from '../../utils/formatDate';
import {
  getWritingPostThumbnail,
  getWritingPostHero,
  hasWritingPostImage,
} from '../../utils/writingPostImage';
import { optimizeWritingIndexImage } from '../../utils/writingIndexImage';
import { buildOgImageUrl } from '../../utils/ogImage';
import '../../styles/pages/writing-editorial.css';

const allPosts = await getCollection('writing');
const posts = (import.meta.env.PROD
  ? allPosts.filter((post) => !post.data.draft)
  : allPosts
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const graph = buildGraph(posts.map((p) => ({ id: p.id, data: p.data, body: p.body })));

const postsWithMeta = await Promise.all(
  posts.map(async (post) => {
    const image = {
      title: post.data.title,
      description: post.data.description,
      coverImage: post.data.coverImage,
      ogImage: post.data.ogImage,
      body: post.body,
    };
    const hasImage = hasWritingPostImage(image);
    const thumbnailUrl = getWritingPostThumbnail(image);
    const heroUrl = getWritingPostHero(image);
    return {
      post,
      hasImage,
      thumbnail: hasImage ? await optimizeWritingIndexImage(thumbnailUrl, 'card') : undefined,
      listThumb: hasImage ? await optimizeWritingIndexImage(thumbnailUrl, 'list') : undefined,
      hero: hasImage ? await optimizeWritingIndexImage(heroUrl, 'spotlight') : undefined,
      primaryTag: post.data.tags?.[0],
    };
  }),
);

const featured = postsWithMeta[0];
const feedPosts = postsWithMeta.slice(1);

const pageDescription =
  'Essays on design, engineering, AI, and entrepreneurship.';
const ogImage = buildOgImageUrl({
  title: 'Writing',
  description: pageDescription,
  type: 'writing',
});
---

<WritingLayout title="Writing | David Hoang" description={pageDescription} ogImage={ogImage}>
  <header class="writing-masthead">
    <h1 class="writing-masthead__title">Writing</h1>
    <div class="writing-masthead__actions">
      <div class="writing-view-tabs" role="tablist" aria-label="Writing view">
        <button
          type="button"
          class="writing-view-tab is-active"
          role="tab"
          aria-selected="true"
          id="writing-tab-editorial"
          aria-controls="writing-panel-editorial"
          tabindex="0"
          data-view-tab="editorial"
        >
          Editorial
        </button>
        <button
          type="button"
          class="writing-view-tab"
          role="tab"
          aria-selected="false"
          id="writing-tab-list"
          aria-controls="writing-panel-list"
          tabindex="-1"
          data-view-tab="list"
        >
          List
        </button>
        <button
          type="button"
          class="writing-view-tab"
          role="tab"
          aria-selected="false"
          id="writing-tab-graph"
          aria-controls="writing-panel-graph"
          tabindex="-1"
          data-view-tab="graph"
        >
          Graph
        </button>
      </div>
    </div>
  </header>

  <div data-view-panel="editorial" id="writing-panel-editorial" role="tabpanel" aria-labelledby="writing-tab-editorial" tabindex="0">
    {featured && (
      <section class="writing-spotlight" aria-label="Featured essay">
        <a href={`/writing/${featured.post.id}`} class="writing-spotlight__link link-plain">
          <div class="writing-spotlight__media">
            {featured.hero ? (
              <img
                src={featured.hero.src}
                srcset={featured.hero.srcSet}
                sizes={featured.hero.sizes}
                alt=""
                class="writing-spotlight__image"
                loading="eager"
                decoding="async"
                fetchpriority="high"
                width={featured.hero.width}
                height={featured.hero.height}
              />
            ) : (
              <WritingDefaultCover seed={featured.post.id} class="writing-spotlight__image" />
            )}
          </div>
          <div class="writing-spotlight__body">
            {featured.primaryTag && <span class="writing-spotlight__tag">{featured.primaryTag}</span>}
            <h2 class="writing-spotlight__title" transition:name={`title-${featured.post.id}`}>
              {featured.post.data.title}
            </h2>
            {featured.post.data.description && (
              <p class="writing-spotlight__deck">{featured.post.data.description}</p>
            )}
            <p class="writing-spotlight__meta">
              <time datetime={featured.post.data.pubDate.toISOString()}>
                {formatListDate(featured.post.data.pubDate)}
              </time>
            </p>
          </div>
        </a>
      </section>
    )}

    {feedPosts.length > 0 && (
      <section class="writing-grid index-card-grid" aria-label="All essays">
        {feedPosts.map(({ post, thumbnail, hasImage, primaryTag }) => (
          <ContentIndexCard
            href={`/writing/${post.id}`}
            title={post.data.title}
            description={post.data.description}
            date={post.data.pubDate}
            imageSrc={thumbnail?.src}
            imageSrcSet={thumbnail?.srcSet}
            imageSizes={thumbnail?.sizes}
            imageWidth={thumbnail?.width}
            imageHeight={thumbnail?.height}
            primaryTag={primaryTag}
            linkClass="link-plain"
            writingTitleViewTransition
          >
            {!hasImage && <WritingDefaultCover slot="media" seed={post.id} />}
          </ContentIndexCard>
        ))}
      </section>
    )}
  </div>

  <div data-view-panel="list" id="writing-panel-list" role="tabpanel" aria-labelledby="writing-tab-list" tabindex="0" hidden>
    <section class="writing-feed" aria-label="Essay list">
      <ul class="writing-feed__list">
        {postsWithMeta.map(({ post, listThumb }) => (
          <li>
            <a href={`/writing/${post.id}`} class="writing-feed__item link-plain">
              <div class="writing-feed__thumb">
                {listThumb ? (
                  <img
                    src={listThumb.src}
                    srcset={listThumb.srcSet}
                    sizes={listThumb.sizes}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    width={listThumb.width}
                    height={listThumb.height}
                  />
                ) : (
                  <WritingDefaultCover seed={post.id} />
                )}
              </div>
              <div class="writing-feed__content">
                <h3 class="writing-feed__title">
                  {post.data.title}
                </h3>
                {post.data.description && (
                  <p class="writing-feed__deck">{post.data.description}</p>
                )}
                <p class="writing-feed__meta">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {formatListDate(post.data.pubDate)}
                  </time>
                </p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <div data-view-panel="graph" id="writing-panel-graph" role="tabpanel" aria-labelledby="writing-tab-graph" tabindex="0" hidden>
    <WritingGraph graph={graph} />
  </div>
</WritingLayout>

<script>
  function initWritingViewTabs() {
    const tablist = document.querySelector<HTMLElement>('.writing-view-tabs');
    if (!tablist || tablist.dataset.initialized === 'true') return;
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-view-tab]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-view-panel]'));
    if (!tabs.length || !panels.length) return;

    function setView(view: string, push: boolean) {
      tabs.forEach((t) => {
        const active = t.dataset.viewTab === view;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', active ? 'true' : 'false');
        t.tabIndex = active ? 0 : -1;
      });
      panels.forEach((p) => {
        const active = p.dataset.viewPanel === view;
        p.hidden = !active;
        if (active && view === 'graph') {
          p.querySelector('[data-writing-graph]')?.dispatchEvent(new CustomEvent('graph:show'));
        }
      });

      if (push) {
        const url = new URL(window.location.href);
        if (view === 'editorial') url.searchParams.delete('view');
        else url.searchParams.set('view', view);
        window.history.replaceState(window.history.state, '', url.toString());
      }
    }

    tabs.forEach((t) => {
      t.addEventListener('click', () => setView(t.dataset.viewTab || 'editorial', true));
      t.addEventListener('keydown', (event) => {
        let index = tabs.indexOf(t);
        if (event.key === 'ArrowRight') index = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') index = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') index = 0;
        else if (event.key === 'End') index = tabs.length - 1;
        else return;
        event.preventDefault();
        const next = tabs[index];
        setView(next.dataset.viewTab || 'editorial', true);
        next.focus();
      });
    });

    const viewParam = new URLSearchParams(window.location.search).get('view');
    const initial =
      viewParam === 'list' || viewParam === 'graph' || viewParam === 'garden'
        ? viewParam === 'garden'
          ? 'graph'
          : viewParam
        : 'editorial';
    setView(initial, false);
    tablist.dataset.initialized = 'true';
  }

  initWritingViewTabs();
  document.addEventListener('astro:page-load', initWritingViewTabs);
</script>
