---
import MainLayout from '../layouts/MainLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const pageDescription =
  'Labs is retired. Current experiments live on the experiments page.';
const ogImage = '/images/img-dh.webp';
---

<MainLayout title="Labs - David Hoang" description={pageDescription} ogImage={ogImage}>
  <PageHeader title="Labs" image="/images/highlights/img-highlights-proof-of-concept.webp" alt="Labs" />
  <div class="container labs-deprecation">
    <p class="labs-deprecation__lead">
      The Labs demos are <strong>retired</strong>. Everything still running moved to <a href="/experiments">Experiments</a> — the daily theme generator, typed model output, WebGL scenes, and editorial prototypes.
    </p>
    <p class="labs-deprecation__muted">
      This page stays up for existing links. You can also browse from <a href="/">the homepage</a> or read the longer write-ups at
      <a href="https://www.proofofconcept.pub" target="_blank" rel="noopener">Proof of Concept</a>.
    </p>
  </div>
</MainLayout>

<style>
  .labs-deprecation {
    max-width: 42rem;
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-xl);
  }

  .labs-deprecation__lead {
    font-size: 1.1rem;
    line-height: 1.55;
    margin: 0 0 var(--spacing-md);
  }

  .labs-deprecation__muted {
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0;
  }

  .labs-deprecation__lead a,
  .labs-deprecation__muted a {
    color: var(--color-link);
  }
</style>
