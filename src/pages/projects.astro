---
import MainLayout from '../layouts/MainLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { projects } from '../data/projects';

const pageDescription =
  'Build in public — software experiments shipped while they are still being figured out.';
const ogImage = '/images/highlights/img-highlights-proof-of-concept.webp';
---

<MainLayout
  title="Projects | David Hoang"
  description={pageDescription}
  ogImage={ogImage}
  robots="noindex, follow"
>
  <PageHeader
    title="Projects"
    image="/images/highlights/img-highlights-proof-of-concept.webp"
    alt="Projects"
  />
  <div class="content-page content-page--compact-top projects-page container-narrow">
    <p class="content-page__lede">
      Software I am building in public. These are live experiments — incomplete on purpose,
      updated as the work teaches me something.
    </p>

    <ol class="projects-list" aria-label="Build in public projects">
      {
        projects.map((project, index) => (
          <li class="projects-list__item">
            <article class="card card-filled project-card">
              <div class="project-card__meta">
                <span class="project-card__index">{String(index + 1).padStart(2, '0')}</span>
                <span class="project-card__built">Built with {project.builtWith}</span>
              </div>
              <h2 class="project-card__title">
                <a href={project.href} target="_blank" rel="noopener noreferrer">
                  {project.title}
                </a>
              </h2>
              <p class="project-card__summary">{project.summary}</p>
              <p class="project-card__actions">
                <a
                  class="project-card__primary"
                  href={project.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {project.hrefLabel}
                  <span aria-hidden="true">↗</span>
                </a>
                {project.links?.map((link) => (
                  <a
                    class="project-card__secondary"
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {link.label}
                  </a>
                ))}
              </p>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</MainLayout>

<style>
  .projects-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .project-card {
    display: block;
    color: inherit;
  }

  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-xs) var(--spacing-md);
    margin-bottom: var(--spacing-sm);
  }

  .project-card__index {
    font-size: var(--text-eyebrow-size, 0.6875rem);
    font-weight: 600;
    letter-spacing: var(--text-eyebrow-tracking, 0.12em);
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--color-link);
  }

  .project-card__built {
    font-size: var(--text-caption-size, 0.8125rem);
    line-height: 1.35;
    letter-spacing: var(--letter-spacing-caption);
    color: var(--color-muted);
  }

  .project-card__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    font-weight: var(--heading-weight);
    line-height: 1.15;
    letter-spacing: var(--letter-spacing-heading-md, var(--letter-spacing-display));
  }

  .project-card__title a {
    color: var(--color-text);
    text-decoration: none;
  }

  @media (hover: hover) {
    .project-card__title a:hover {
      color: var(--color-link);
    }
  }

  .project-card__title a:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .project-card__summary {
    margin: var(--spacing-md) 0 0;
    font-size: var(--body-size);
    line-height: 1.55;
    letter-spacing: var(--letter-spacing-body);
    color: var(--color-muted);
  }

  .project-card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--spacing-sm) var(--spacing-md);
    margin: var(--spacing-md) 0 0;
  }

  .project-card__primary,
  .project-card__secondary {
    font-size: var(--text-caption-size, 0.9rem);
    line-height: 1.4;
    text-decoration: none;
  }

  .project-card__primary {
    color: var(--color-link);
    font-weight: 650;
  }

  .project-card__secondary {
    color: var(--color-muted);
  }

  @media (hover: hover) {
    .project-card__primary:hover,
    .project-card__secondary:hover {
      text-decoration: underline;
    }
  }

  .project-card__primary:focus-visible,
  .project-card__secondary:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }
</style>
