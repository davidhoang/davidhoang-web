---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import {
  thesisReadingHref,
  thesisSections,
  type ThesisReadingLink,
} from '../data/thesis';

const pageDescription =
  'My convictions on the future of software design, AI-native management, the post-IDE world, and human × AI collaboration — with further reading into essays and notes.';
const ogImage = '/images/img-dh.webp';

const writingById = new Map(
  (await getCollection('writing', ({ data }) => !data.draft)).map((entry) => [entry.id, entry])
);
const notesById = new Map(
  (await getCollection('notes', ({ data }) => !data.draft)).map((entry) => [entry.id, entry])
);

function resolveReading(link: ThesisReadingLink) {
  if (link.kind === 'writing') {
    const entry = writingById.get(link.id);
    if (!entry) {
      throw new Error(`Thesis hub: missing writing entry "${link.id}"`);
    }
    return {
      ...link,
      title: entry.data.title,
      href: thesisReadingHref(link),
      external: false as const,
    };
  }
  if (link.kind === 'notes') {
    const entry = notesById.get(link.id);
    if (!entry) {
      throw new Error(`Thesis hub: missing notes entry "${link.id}"`);
    }
    return {
      ...link,
      title: entry.data.title,
      href: thesisReadingHref(link),
      external: false as const,
    };
  }
  return {
    ...link,
    href: thesisReadingHref(link),
    external: true as const,
  };
}

const sections = thesisSections.map((section) => ({
  ...section,
  reading: section.reading.map(resolveReading),
}));
---

<MainLayout title="Thesis | David Hoang" description={pageDescription} ogImage={ogImage}>
  <PageHeader
    title="Conviction"
    image="/images/highlights/img-highlights-proof-of-concept.webp"
    alt="Conviction"
  />
  <div class="content-page thesis-hub container-narrow">
    <section class="content-page__intro">
      <p class="text-eyebrow">Living thesis</p>
      <p>
        A working set of convictions on where software design is headed, how teams should operate
        with AI, and what changes when the IDE stops being the center of gravity. Each section links
        to essays and notes that argue the point — conviction to evidence in one click.
      </p>
    </section>

    <section class="thesis-toc" aria-labelledby="toc-heading">
      <h2 id="toc-heading" class="text-eyebrow thesis-toc__title">Table of contents</h2>
      <nav aria-label="Table of contents">
        <ol class="thesis-toc__list">
          {
            sections.map((section) => (
              <li>
                <a href={`#${section.id}`}>{section.title}</a>
              </li>
            ))
          }
        </ol>
      </nav>
    </section>

    {
      sections.map((section) => (
        <section id={section.id} class="content-page__section thesis-section" aria-labelledby={`${section.id}-title`}>
          <h2 id={`${section.id}-title`}>{section.title}</h2>
          <p>{section.lede}</p>
          <ul class="content-page__list content-page__list--bullets">
            {section.points.map((point) => (
              <li>
                <strong>{point.label}:</strong> {point.body}
              </li>
            ))}
          </ul>
          <div class="thesis-reading">
            <h3 class="text-eyebrow thesis-reading__heading">Further reading</h3>
            <ul class="content-page__list content-page__list--linked">
              {section.reading.map((item) => (
                <li>
                  <a
                    href={item.href}
                    {...(item.external
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                  >
                    {item.title}
                    {item.external ? <span class="thesis-reading__ext" aria-hidden="true"> ↗</span> : null}
                  </a>
                  <span class="content-page__list-note">{item.note}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))
    }

    <section class="content-page__section thesis-more" aria-labelledby="thesis-more-heading">
      <h2 id="thesis-more-heading">Keep exploring</h2>
      <ul class="content-page__list content-page__list--linked">
        <li>
          <a href="/writing">Writing</a>
          <span class="content-page__list-note">Longer essays across craft, career, and AI</span>
        </li>
        <li>
          <a href="/notes">Notes</a>
          <span class="content-page__list-note">The digital garden — sketches that feed the thesis</span>
        </li>
        <li>
          <a href="https://www.proofofconcept.pub" target="_blank" rel="noopener noreferrer">
            Proof of Concept
            <span class="thesis-reading__ext" aria-hidden="true"> ↗</span>
          </a>
          <span class="content-page__list-note">Weekly writing where many of these ideas first shipped</span>
        </li>
      </ul>
    </section>
  </div>
</MainLayout>

<style>
  .thesis-hub .thesis-toc {
    margin: 0 0 var(--spacing-2xl);
    padding: var(--spacing-md);
    border-radius: var(--radius-md);
    background: var(--color-sidebar-bg);
  }

  .thesis-toc__title {
    margin: 0 0 var(--spacing-sm);
  }

  .thesis-toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .thesis-toc__list li {
    margin: var(--spacing-xs) 0;
  }

  .thesis-toc__list a {
    color: var(--color-link);
    text-decoration: none;
    font-weight: 500;
  }

  @media (hover: hover) {
    .thesis-toc__list a:hover {
      color: var(--color-accent, var(--color-text));
    }
  }

  .thesis-section {
    scroll-margin-top: calc(var(--nav-height, 48px) + var(--spacing-lg));
  }

  .thesis-reading {
    margin-top: var(--spacing-lg);
    padding-top: var(--spacing-md);
    border-top: 1px solid color-mix(in srgb, var(--color-border) 75%, transparent);
  }

  .thesis-reading__heading {
    margin: 0 0 var(--spacing-md);
  }

  .thesis-reading__ext {
    font-weight: 400;
    opacity: 0.7;
  }

  .thesis-more {
    margin-top: var(--spacing-xl);
  }

  @keyframes thesis-section-target {
    0% {
      background-color: var(--color-search-target);
    }
    100% {
      background-color: transparent;
    }
  }

  .thesis-section:target {
    animation: thesis-section-target var(--duration-slowest) var(--ease-inertia);
    border-radius: var(--radius-sm, 4px);
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }

    .thesis-section:target {
      animation: none;
    }
  }
</style>
