---
import MainLayout from '../layouts/MainLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const advisingInquiryUrl = 'https://tally.so/r/D4M0lb';

const pageDescription =
  'Advising for Heads of Design at growth-stage startups — org scale, executive partnership, and design as strategy.';
const ogImage = '/images/header-images/img-header-advising.webp';
---

<MainLayout title="Advising | David Hoang" description={pageDescription} ogImage={ogImage}>
  <PageHeader
    title="Advising"
    image={ogImage}
    alt="Ink sketch of a letter and a group of people"
    priority={true}
  />
  <div class="content-page content-page--compact-top advising-content container-narrow">
    <section class="content-page__intro">
      <p>
        I've spent 20 years building design teams — now VP of AI Design at Atlassian, previously VP
        of Marketing and Design at Replit, first Head of Design at Webflow, and Head of Product
        Design at One Medical through its IPO.
      </p>
      <p>
        At Series A–C, the job shifts from product quality to org design, executive influence,
        hiring, and clarity on what design owns. I advise a few leaders at a time when that
        experience maps to their context — stronger taste, operating rhythm, executive trust, and
        room in company strategy.
      </p>
    </section>

    <section class="content-page__section">
      <h2>Who it's for</h2>
      <ul class="content-page__list content-page__list--bullets">
        <li>You lead design at a Series A–C company</li>
        <li>Your team is growing, but the operating model is still forming</li>
        <li>You're navigating executive partnership, hiring, quality, or team structure</li>
        <li>You want a practitioner-advisor, not generic leadership coaching</li>
      </ul>
    </section>

    <section class="content-page__section">
      <h2>Advisory themes</h2>
      <ul class="content-page__list content-page__list--bullets">
        <li><strong>Strategic design:</strong> trust with founders, product, and engineering</li>
        <li><strong>Operating rhythm:</strong> critique, reviews, and decision systems</li>
        <li><strong>Team architecture:</strong> org design, hiring, leveling, and growing leaders</li>
        <li><strong>Taste and craft:</strong> culture that recognizes and ships better work</li>
        <li><strong>AI and design:</strong> leadership as software creation changes</li>
      </ul>
    </section>

    <section class="content-page__section">
      <h2>How it works</h2>
      <ul class="content-page__list content-page__list--bullets">
        <li>Start from the leadership challenge you're navigating now</li>
        <li>Usually monthly sessions with async support between meetings</li>
        <li>Practical and context-specific — not a fixed curriculum</li>
        <li>A handful of relationships each year; I'll say no when I'm not the right fit</li>
      </ul>
    </section>

    <section class="content-page__section advising-writing">
      <h2>Related writing</h2>
      <ul class="content-page__list content-page__list--linked">
        <li>
          <a href="/writing/designs-seat-at-the-cap-table-part-i">Design's Seat at the Cap Table</a>
          <span class="content-page__list-note">design leadership and influence</span>
        </li>
        <li>
          <a href="/writing/design-engineering">Design Engineering</a>
          <span class="content-page__list-note">design, software, and technical craft</span>
        </li>
        <li>
          <a href="/writing/email-updates-to-career-advisors">Keeping an advisory close</a>
          <span class="content-page__list-note">durable advisory relationships</span>
        </li>
      </ul>
    </section>

    <section class="card advising-cta" aria-labelledby="advising-apply-heading">
      <h2 id="advising-apply-heading" class="content-page__section-title">Apply</h2>
      <p class="advising-cta__body text-muted">
        Share your company, team, and the challenge you're navigating. I read every submission and
        follow up when there's a clear fit.
      </p>
      <a class="btn btn-primary advising-cta__button" href={advisingInquiryUrl} target="_blank" rel="noopener noreferrer">
        Submit an inquiry
        <span class="advising-cta__arrow" aria-hidden="true">→</span>
      </a>
      <p class="text-caption advising-cta__note">Opens in a new tab.</p>
    </section>
  </div>
</MainLayout>

<style>
  .advising-cta {
    margin-top: var(--spacing-2xl);
    padding: clamp(var(--spacing-lg), 4vw, calc(var(--spacing-xl) + var(--spacing-sm)));
  }

  .advising-cta__body {
    margin: 0 0 var(--spacing-lg);
    font-size: var(--body-size);
    line-height: var(--body-line-height);
    max-width: 52ch;
  }

  .advising-cta__button {
    font-weight: 600;
  }

  .advising-cta__button::after {
    display: none;
  }

  .advising-cta__arrow {
    transition: transform var(--duration-normal) var(--ease-inertia);
  }

  @media (hover: hover) {
    .advising-cta__button:hover .advising-cta__arrow {
      transform: translateX(3px);
    }
  }

  .advising-content .advising-cta__note {
    margin: var(--spacing-md) 0 0;
  }

  @media (max-width: 768px) {
    .advising-cta__button {
      width: 100%;
    }
  }
</style>
