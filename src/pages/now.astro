---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import HomeViewer from '../components/homes/HomeViewer';
import imgDavidNow from '../assets/images/img-david-now.webp';
import {
  buildNowPageJsonLd,
  NOW_LAST_UPDATED,
  NOW_LAST_UPDATED_LABEL,
} from '../utils/structuredData';
import { nowReading, nowReadingHref, type NowReadingItem } from '../data/nowReading';
import '../components/homes/homes.css';

const pageDescription =
  'What David Hoang is focused on now — AI design at Atlassian, Proof of Concept, agent experience, angel investing, and life between Palm Springs, San Francisco, and Sydney.';

const nowJsonLd = buildNowPageJsonLd({
  description: pageDescription,
  dateModified: NOW_LAST_UPDATED,
});

const writingById = new Map(
  (await getCollection('writing', ({ data }) => !data.draft)).map((entry) => [entry.id, entry])
);
const notesById = new Map(
  (await getCollection('notes', ({ data }) => !data.draft)).map((entry) => [entry.id, entry])
);

function resolveNowReading(item: NowReadingItem) {
  if (item.kind === 'writing') {
    const entry = writingById.get(item.id);
    if (!entry) {
      throw new Error(`Now page: missing writing entry "${item.id}"`);
    }
    return {
      ...item,
      title: entry.data.title,
      href: nowReadingHref(item),
      external: false as const,
    };
  }
  if (item.kind === 'notes') {
    const entry = notesById.get(item.id);
    if (!entry) {
      throw new Error(`Now page: missing notes entry "${item.id}"`);
    }
    return {
      ...item,
      title: entry.data.title,
      href: nowReadingHref(item),
      external: false as const,
    };
  }
  return {
    ...item,
    href: nowReadingHref(item),
    external: true as const,
  };
}

const readingNow = nowReading.map(resolveNowReading);
---

<MainLayout
  title="Now | David Hoang"
  description={pageDescription}
  containerClass="container container-wide"
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(nowJsonLd)} />
  <PageHeader
    title="Now"
    image={imgDavidNow.src}
    alt="David Hoang sitting on a Sydney beach"
  />
  <div class="content-page now-content">
    <div class="container-narrow">
      <p class="content-page__meta">
        Last updated: <time datetime={NOW_LAST_UPDATED}>{NOW_LAST_UPDATED_LABEL}</time>. Learn more about
        <a href="https://nownownow.com/" target="_blank" rel="noopener noreferrer">Now pages</a>.
      </p>
    </div>

    <section
      id="places-i-call-home"
      class="content-page__section now-homes"
      aria-label="Places I call home"
      data-diorama-revision="3"
    >
      <div class="container-narrow">
        <h2 class="now-homes__heading">Places I call home</h2>
        <p class="now-homes__lede text-muted">
          Drag to orbit the clay miniatures.
        </p>
      </div>
      <div class="homes-pair now-homes__grid">
        <HomeViewer
          client:visible={{ rootMargin: '300px' }}
          kind="desert"
          name="Palm Springs"
          modelUrl="/models/homes/greco-court.glb"
          posterUrl="/images/homes/greco-court.webp"
        />
        <HomeViewer
          client:visible={{ rootMargin: '300px' }}
          kind="clocktower"
          name="San Francisco"
          modelUrl="/models/homes/clocktower.glb"
          posterUrl="/images/homes/clocktower.webp"
        />
      </div>
    </section>

    <div class="container-narrow now-focus">
      <section class="content-page__section" aria-labelledby="now-work-heading">
        <h2 id="now-work-heading">Work</h2>
        <ul class="content-page__list content-page__list--bullets" role="list">
          <li>
            <a href="/about">VP of AI Design at Atlassian</a> — AI and ecosystem experiences
          </li>
          <li>
            <a href="/writing/optimizing-for-agents">Learning agent experience</a> — design for people
            and AI answer engines
          </li>
        </ul>
      </section>

      <section class="content-page__section" aria-labelledby="now-writing-heading">
        <h2 id="now-writing-heading">Writing &amp; investing</h2>
        <ul class="content-page__list content-page__list--bullets" role="list">
          <li>
            Publishing weekly on
            <a href="https://www.proofofconcept.pub/" target="_blank" rel="noopener noreferrer">Proof of Concept</a>
          </li>
          <li>
            <a href="/investing">Angel investing</a> in design, AI, and creative tools
          </li>
          <li>
            <a href="/thesis">Conviction</a> — the longer arc behind the newsletter
          </li>
        </ul>
      </section>

      <section class="content-page__section" aria-labelledby="now-life-heading">
        <h2 id="now-life-heading">Life</h2>
        <ul class="content-page__list content-page__list--bullets" role="list">
          <li>
            Living between <a href="#places-i-call-home">Palm Springs and San Francisco</a>, with trips to
            Sydney
          </li>
          <li>
            <a href="/advising">Advising</a> a few Heads of Design when the fit is right
          </li>
        </ul>
      </section>

      <section class="content-page__section" aria-labelledby="now-reading-heading">
        <h2 id="now-reading-heading">Reading now</h2>
        <p class="now-reading__lede text-muted">Essays and notes I'm actively pointing people to.</p>
        <ul class="content-page__list content-page__list--linked">
          {
            readingNow.map((item) => (
              <li>
                <a
                  href={item.href}
                  {...(item.external
                    ? { target: '_blank', rel: 'noopener noreferrer' }
                    : {})}
                >
                  {item.title}
                  {item.external ? <span class="now-reading__ext" aria-hidden="true"> ↗</span> : null}
                </a>
                <span class="content-page__list-note">{item.note}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="content-page__section" aria-labelledby="now-recent-heading">
        <h2 id="now-recent-heading">Recent on the site</h2>
        <ul class="content-page__list content-page__list--linked">
          <li>
            <a href="/writing">Writing archive</a>
            <span class="content-page__list-note">Longer essays on craft, career, and AI</span>
          </li>
          <li>
            <a href="/featured">Featured talks &amp; media</a>
            <span class="content-page__list-note">Where the themes show up in public</span>
          </li>
        </ul>
      </section>
    </div>
  </div>
</MainLayout>

<style>
  .now-reading {
    margin-inline: auto;
  }

  .now-homes {
    margin-bottom: var(--spacing-2xl);
    padding-top: var(--spacing-xl);
  }

  .now-homes__heading {
    font-family: var(--font-heading);
    font-size: var(--section-heading-size);
    font-weight: var(--heading-weight);
    margin: 0 0 var(--spacing-sm);
    color: var(--color-text);
    letter-spacing: var(--letter-spacing-heading-md);
    line-height: 1.2;
  }

  .now-homes__lede {
    margin: 0 0 var(--spacing-xl);
    max-width: 42rem;
  }

  .now-homes__grid {
    margin-top: 0;
  }

  .now-focus .content-page__section:first-of-type {
    padding-top: var(--spacing-lg);
  }

  .now-reading__lede {
    margin: 0 0 var(--spacing-md);
    max-width: 42rem;
  }

  .now-reading__ext {
    font-weight: 400;
  }

  @media (max-width: 768px) {
    .now-homes {
      padding-top: var(--spacing-lg);
    }
  }
</style>
