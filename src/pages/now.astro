---
import MainLayout from '../layouts/MainLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import HomeViewer from '../components/homes/HomeViewer';
import imgDavidNow from '../assets/images/img-david-now.webp';
import buildingSimcityCover from '../assets/images/books/building-simcity.webp';
import {
  buildNowPageJsonLd,
  NOW_LAST_UPDATED,
  NOW_LAST_UPDATED_LABEL,
} from '../utils/structuredData';
import '../components/homes/homes.css';

const pageDescription =
  'What David Hoang is focused on now — AI design at Atlassian, Proof of Concept, agent experience, angel investing, and life between Palm Springs, San Francisco, and Sydney.';

const nowJsonLd = buildNowPageJsonLd({
  description: pageDescription,
  dateModified: NOW_LAST_UPDATED,
});

---

<MainLayout
  title="Now | David Hoang"
  description={pageDescription}
  containerClass="container container-wide"
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(nowJsonLd)} />
  <PageHeader
    title="Now"
    image={imgDavidNow.src}
    alt="David Hoang sitting on a Sydney beach"
  />
  <div class="content-page now-content">
    <div class="container-narrow">
      <p class="content-page__meta">
        Last updated: <time datetime={NOW_LAST_UPDATED}>{NOW_LAST_UPDATED_LABEL}</time>. Learn more about{' '}
        <a href="https://nownownow.com/" target="_blank" rel="noopener noreferrer">Now pages</a>.
      </p>
    </div>

    <section
      id="places-i-call-home"
      class="content-page__section now-homes"
      aria-label="Places I call home"
      data-diorama-revision="3"
    >
      <div class="container-narrow">
        <h2 class="now-homes__heading">Places I call home</h2>
      </div>
      <div class="homes-pair now-homes__grid">
        <HomeViewer
          client:visible={{ rootMargin: '300px' }}
          kind="desert"
          name="Palm Springs"
          modelUrl="/models/homes/greco-court.glb"
          posterUrl="/images/homes/greco-court.webp"
        />
        <HomeViewer
          client:visible={{ rootMargin: '300px' }}
          kind="clocktower"
          name="San Francisco"
          modelUrl="/models/homes/clocktower.glb"
          posterUrl="/images/homes/clocktower.webp"
        />
      </div>
    </section>

    <div class="container-narrow now-focus">
      <section class="content-page__section" aria-labelledby="now-work-heading">
        <h2 id="now-work-heading">Work</h2>
        <ul class="content-page__list content-page__list--bullets" role="list">
          <li>
            <a href="/about">VP of Design, Atlassian</a> — AI and ecosystem experiences
          </li>
          <li>
            <a href="/writing/optimizing-for-agents">Learning agent experience</a> — design for people
            and AI answer engines
          </li>
        </ul>
      </section>

      <section class="content-page__section" aria-labelledby="now-writing-heading">
        <h2 id="now-writing-heading">Writing &amp; investing</h2>
        <ul class="content-page__list content-page__list--bullets" role="list">
          <li>
            Publishing weekly on
            <a href="https://www.proofofconcept.pub/" target="_blank" rel="noopener noreferrer">Proof of Concept</a>
          </li>
          <li>
            <a href="/investing">Angel investing</a> in design, AI, and creative tools
          </li>
          <li>
            <a href="/thesis">Conviction</a> — the longer arc behind the newsletter
          </li>
        </ul>
      </section>

      <section class="content-page__section" aria-labelledby="now-life-heading">
        <h2 id="now-life-heading">Life</h2>
        <ul class="content-page__list content-page__list--bullets" role="list">
          <li>
            Living between <a href="#places-i-call-home">Palm Springs and San Francisco</a>, with trips to
            Sydney
          </li>
          <li>
            <a href="/advising">Advising</a> a few companies when there is a fit
          </li>
        </ul>
      </section>

      <section class="content-page__section" aria-labelledby="now-reading-heading">
        <h2 id="now-reading-heading">Now reading</h2>
        <div class="now-book">
          <a
            class="now-book__cover-link"
            href="https://mitpressbookstore.mit.edu/book/9780262547482"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img
              class="now-book__cover"
              src={buildingSimcityCover.src}
              width={buildingSimcityCover.width}
              height={buildingSimcityCover.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
            <span class="sr-only">Building SimCity (opens in a new tab)</span>
          </a>
          <div class="now-book__copy">
            <cite class="now-book__title">Building SimCity</cite>
            <span class="now-book__subtitle">How to Put the World in a Machine</span>
            <span class="now-book__author">Chaim Gingold</span>
            <a
              class="btn btn-primary now-book__buy"
              href="https://mitpressbookstore.mit.edu/book/9780262547482"
              target="_blank"
              rel="noopener noreferrer"
            >
              Buy the book
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          </div>
        </div>
      </section>
    </div>
  </div>
</MainLayout>

<style>
  .now-book {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
    width: 100%;
  }

  .now-book__cover-link {
    display: block;
    flex: none;
    border-bottom: none;
    line-height: 0;
  }

  .now-book__cover-link::before,
  .now-book__cover-link::after,
  .now-book__buy::before,
  .now-book__buy::after {
    content: none;
  }

  .now-book__cover {
    width: 11rem;
    height: auto;
    flex: none;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-scrolling);
    transition:
      transform var(--duration-slow) var(--ease-standard),
      box-shadow var(--duration-slow) var(--ease-standard);
  }

  .now-book__copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-xs);
    min-width: 0;
  }

  .now-book__title {
    font-family: var(--font-heading);
    font-style: normal;
    font-size: var(--body-size);
    font-weight: var(--heading-weight);
    letter-spacing: var(--letter-spacing-heading-md);
    line-height: 1.2;
    color: var(--color-text);
  }

  .now-book__subtitle,
  .now-book__author {
    color: var(--color-muted);
    font-size: var(--body-size);
    line-height: 1.4;
  }

  .now-book__buy {
    flex: none;
    margin-top: var(--spacing-xs);
  }

  .now-book__buy:hover {
    color: var(--color-bg);
  }

  @media (min-width: 641px) {
    .now-book__copy {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: var(--spacing-xl);
      row-gap: var(--spacing-xs);
      align-items: center;
    }

    .now-book__title,
    .now-book__subtitle,
    .now-book__author {
      grid-column: 1;
    }

    .now-book__buy {
      grid-column: 2;
      grid-row: 1 / span 3;
      margin-top: 0;
    }
  }

  .now-homes {
    margin-bottom: var(--spacing-2xl);
    padding-top: var(--spacing-xl);
  }

  .now-homes__heading {
    font-family: var(--font-heading);
    font-size: var(--section-heading-size);
    font-weight: var(--heading-weight);
    margin: 0 0 var(--spacing-xl);
    color: var(--color-text);
    letter-spacing: var(--letter-spacing-heading-md);
    line-height: 1.2;
  }

  .now-homes__grid {
    margin-top: 0;
  }

  .now-focus .content-page__section:first-of-type {
    padding-top: var(--spacing-lg);
  }

  @media (hover: hover) {
    .now-book__cover-link:hover .now-book__cover {
      transform: translateY(-0.25rem);
      box-shadow: var(--shadow-hover);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .now-book__cover {
      transition: none;
    }

    .now-book__cover-link:hover .now-book__cover {
      transform: none;
    }
  }

  @media (max-width: 767px) {
    .now-homes {
      padding-top: var(--spacing-lg);
    }
  }
</style>
