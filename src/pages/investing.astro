---
import MainLayout from '../layouts/MainLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const pageDescription = "Angel investor and advisor backing founders building at the intersection of design, AI, and tools for creators. Selected investments include Visual Electric, Sublime, Galileo AI, and more.";
const ogImage = "/images/img-dh.webp";
---

<MainLayout title="Investing | David Hoang" description={pageDescription} ogImage={ogImage}>
  <PageHeader title="Investing" image="/images/highlights/img-highlights-proof-of-concept.webp" alt="Investing" />
  <div class="content-page content-page--compact-top investing-content container-narrow">

    <section class="content-page__intro">
      <p>I'm an angel investor and advisor for early-stage startups. I back founders building products that solve real problems for people — particularly at the intersection of design, AI, and creative tools. I'm drawn to teams that care deeply about craft and believe great products come from understanding people first.</p>
    </section>

    <section class="content-page__section">
      <h2>AI & Machine Learning</h2>
      <ul class="content-page__list">
        <li><a href="https://visualelectric.com/" target="_blank" rel="noopener noreferrer">Visual Electric</a> — AI-native image generation for designers</li>
        <li><a href="https://ozu.ai" target="_blank" rel="noopener noreferrer">OZU</a> — AI-powered creative tools</li>
        <li><a href="https://www.usegalileo.ai/explore" target="_blank" rel="noopener noreferrer">Galileo AI</a> — AI-generated UI design <span class="exit-badge">Acquired by Google</span></li>
        <li><a href="https://deepcast.fm" target="_blank" rel="noopener noreferrer">Deepcast</a> — AI-powered podcast platform</li>
      </ul>
    </section>

    <section class="content-page__section">
      <h2>Design & Developer Tools</h2>
      <ul class="content-page__list">
        <li><a href="https://www.dittowords.com" target="_blank" rel="noopener noreferrer">Ditto</a> — Design-integrated copy management</li>
        <li><a href="https://www.eraser.io" target="_blank" rel="noopener noreferrer">Eraser</a> — Technical design docs and diagramming</li>
        <li><a href="https://www.cycle.app" target="_blank" rel="noopener noreferrer">Cycle</a> — Product feedback and insights</li>
        <li><a href="https://opalcamera.com" target="_blank" rel="noopener noreferrer">Opal Camera</a> — Professional-grade webcam hardware</li>
      </ul>
    </section>

    <section class="content-page__section">
      <h2>Communication & Creator Economy</h2>
      <ul class="content-page__list">
        <li><a href="https://sublime.app" target="_blank" rel="noopener noreferrer">Sublime</a> — Curated content and social reading</li>
        <li><a href="https://texts.com" target="_blank" rel="noopener noreferrer">Texts.com</a> — Unified messaging client <span class="exit-badge">Acquired by Automattic</span></li>
        <li><a href="https://www.passionfroot.me" target="_blank" rel="noopener noreferrer">Passionfroot</a> — Creator business management</li>
        <li><a href="https://www.withdaydream.com" target="_blank" rel="noopener noreferrer">Daydream</a> — Immersive social experiences</li>
      </ul>
    </section>

    <section class="content-page__section investing-advising-note">
      <p class="text-muted investing-note-copy">
        I also keep a small <a href="/advising">advisory practice for Heads of Design</a>
        navigating org scale, executive partnership, and design's role in company strategy.
      </p>
    </section>

    <section class="content-page__section investing-cta">
      <p>
        If you're a founder building something in these spaces, I'd love to hear from you —
        <a href="mailto:david@davidhoang.com">david@davidhoang.com</a>.
      </p>
    </section>
  </div>
</MainLayout>

<style>
  .exit-badge {
    display: inline-block;
    font-size: var(--text-eyebrow-size, 0.6875rem);
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: calc(var(--spacing-xs) - 0.125rem) var(--spacing-sm);
    margin-left: var(--spacing-xs);
    vertical-align: middle;
  }

  .investing-note-copy {
    margin: 0;
    font-size: var(--body-size);
    line-height: 1.65;
  }

  .investing-note-copy a {
    color: var(--color-link);
    font-weight: 600;
  }

  .investing-cta p {
    margin: 0;
    font-size: var(--body-size);
    line-height: var(--body-line-height);
    color: var(--color-text);
  }
</style>
