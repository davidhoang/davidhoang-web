---
import MainLayout from '../layouts/MainLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { absoluteUrl, buildWebPageJsonLd } from '../utils/structuredData';

const pageDescription =
  'Angel investor in design, AI, and creative tools — Visual Electric, Sublime, Galileo AI, and others.';
const investingCanonicalUrl = absoluteUrl('/investing');
const investingPageJsonLd = buildWebPageJsonLd({
  name: 'Investing',
  description: pageDescription,
  canonicalUrl: investingCanonicalUrl,
});
---

<MainLayout title="Investing | David Hoang" description={pageDescription}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(investingPageJsonLd)} />
  <PageHeader title="Investing" image="/images/highlights/img-highlights-proof-of-concept.webp" alt="Investing" />
  <div class="content-page content-page--compact-top investing-content container-narrow">

    <section class="content-page__intro">
      <p>
        I back early-stage founders at the intersection of design, AI, and creative tools — teams
        that care about craft and the people they serve.
      </p>
    </section>

    <section class="content-page__section">
      <h2>AI & Machine Learning</h2>
      <ul class="content-page__list">
        <li><a href="https://web.archive.org/web/20260308232534/https://visualelectric.com/" target="_blank" rel="noopener noreferrer">Visual Electric<span class="sr-only"> (opens in a new tab)</span></a></li>
        <li><a href="https://web.archive.org/web/20260812092052/https://www.ozu.ai/" target="_blank" rel="noopener noreferrer">OZU<span class="sr-only"> (opens in a new tab)</span></a></li>
        <li><a href="https://www.usegalileo.ai/explore" target="_blank" rel="noopener noreferrer">Galileo AI<span class="sr-only"> (opens in a new tab)</span></a> <span class="exit-badge">Acquired by Google</span></li>
        <li><a href="https://web.archive.org/web/20260615110801/https://www.deepcast.fm/" target="_blank" rel="noopener noreferrer">Deepcast<span class="sr-only"> (opens in a new tab)</span></a></li>
      </ul>
    </section>

    <section class="content-page__section">
      <h2>Design & Developer Tools</h2>
      <ul class="content-page__list">
        <li><a href="https://www.dittowords.com" target="_blank" rel="noopener noreferrer">Ditto<span class="sr-only"> (opens in a new tab)</span></a></li>
        <li><a href="https://www.eraser.io" target="_blank" rel="noopener noreferrer">Eraser<span class="sr-only"> (opens in a new tab)</span></a></li>
        <li><a href="https://web.archive.org/web/20260418010433/https://cycle.app/" target="_blank" rel="noopener noreferrer">Cycle<span class="sr-only"> (opens in a new tab)</span></a></li>
        <li><a href="https://opalcamera.com" target="_blank" rel="noopener noreferrer">Opal Camera<span class="sr-only"> (opens in a new tab)</span></a></li>
      </ul>
    </section>

    <section class="content-page__section">
      <h2>Communication & Creator Economy</h2>
      <ul class="content-page__list">
        <li><a href="https://sublime.app" target="_blank" rel="noopener noreferrer">Sublime<span class="sr-only"> (opens in a new tab)</span></a></li>
        <li><a href="https://texts.com" target="_blank" rel="noopener noreferrer">Texts.com<span class="sr-only"> (opens in a new tab)</span></a> <span class="exit-badge">Acquired by Automattic</span></li>
        <li><a href="https://www.passionfroot.me" target="_blank" rel="noopener noreferrer">Passionfroot<span class="sr-only"> (opens in a new tab)</span></a></li>
        <li><a href="https://www.withdaydream.com" target="_blank" rel="noopener noreferrer">Daydream<span class="sr-only"> (opens in a new tab)</span></a></li>
      </ul>
    </section>

    <section class="content-page__section investing-advising-note">
      <p class="text-muted investing-note-copy">
        I also advise a few <a href="/advising">Heads of Design</a> at growth-stage startups.
      </p>
    </section>

    <section class="content-page__section investing-cta">
      <p>
        Founders in these spaces: <a href="mailto:david@davidhoang.com">david@davidhoang.com</a>.
      </p>
    </section>
  </div>
</MainLayout>

<style>
  .exit-badge {
    display: inline-block;
    font-size: var(--text-eyebrow-size);
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: calc(var(--spacing-xs) - 0.125rem) var(--spacing-sm);
    margin-left: var(--spacing-xs);
    vertical-align: middle;
  }

  .investing-note-copy {
    margin: 0;
    font-size: var(--body-size);
    line-height: 1.65;
  }

  .investing-note-copy a {
    color: var(--color-link);
    font-weight: 600;
  }

  .investing-cta p {
    margin: 0;
    font-size: var(--body-size);
    line-height: var(--body-line-height);
    color: var(--color-text);
  }
</style>
