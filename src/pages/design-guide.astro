<script>
  function updateThemeInfo() {
    const root = document.documentElement;

    const themeActive = root.hasAttribute('data-daily-theme');
    const cardStyle = root.getAttribute('data-card-style') || 'default';
    const linkStyle = root.getAttribute('data-link-style') || 'default';
    const heroLayout = root.getAttribute('data-hero-layout') || 'default';
    const imageStyle = root.getAttribute('data-image-style') || 'default';
    const gridStyle = root.getAttribute('data-grid-style') || 'standard';
    const texture = root.getAttribute('data-bg-texture') || 'none';
    const footerStyle = root.getAttribute('data-footer-style') || 'default';

    const set = (id: string, value: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = value;
    };
    set('theme-active', themeActive ? 'Yes (' + root.getAttribute('data-daily-theme') + ')' : 'No (using default)');
    set('theme-card', cardStyle);
    set('theme-link', linkStyle);
    set('theme-hero', heroLayout);
    set('theme-image', imageStyle);
    set('theme-grid', gridStyle);
    set('theme-texture', texture);
    set('theme-footer', footerStyle);
  }

  // Update on load
  updateThemeInfo();

  // Update when theme changes
  const observer = new MutationObserver(updateThemeInfo);
  observer.observe(document.documentElement, { attributes: true });

  // Update on Astro navigation
  document.addEventListener('astro:page-load', updateThemeInfo);
</script>
