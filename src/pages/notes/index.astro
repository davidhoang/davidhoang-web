---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import PageHeader from '../../components/PageHeader.astro';
import SearchInput from '../../components/SearchInput.astro';
import ContentIndexCard from '../../components/ContentIndexCard.astro';
import { NOTE_STAGE_VALUES, resolveNoteStage } from '../../content/noteStages';
import { noteStageInfo } from '../../utils/noteStageInfo';
import '../../styles/modules/content-index.css';

const allNotes = await getCollection('notes');
const notes = (import.meta.env.PROD
  ? allNotes.filter((note) => !note.data.draft)
  : allNotes
).sort((a, b) => {
  const dateA = a.data.updatedDate || a.data.pubDate;
  const dateB = b.data.updatedDate || b.data.pubDate;
  return dateB.valueOf() - dateA.valueOf();
});

const allTags = [...new Set(notes.flatMap((note) => note.data.tags || []))].sort();

const pageDescription =
  'Evergreen notes from my digital garden. Ideas I come back to, tend, and grow over time.';
const pageOgImage = '/images/highlights/img-highlights-play.webp';

const notesPlaceholderSketch =
  '/images/blog/2022/img-2022-10-16-artifacts-one-medical.webp';
---

<MainLayout title="Notes | David Hoang" description={pageDescription} ogImage={pageOgImage}>
  <PageHeader
    title="Notes"
    image="/images/highlights/img-highlights-play.webp"
    alt="Abstract sketch representing notes and ideas"
    priority={true}
  />

  <section class="notes-intro" aria-labelledby="notes-intro-heading">
    <h2 id="notes-intro-heading" class="sr-only">About this garden</h2>
    <p class="notes-intro__lede">
      Working notes from my digital garden — shorter, evolving ideas than the essays on{' '}
      <a href="/writing">Writing</a>. Filter by topic or growth stage, or search across everything.{' '}
      <a href="/rss/notes.xml" class="notes-intro__rss">RSS feed</a>
    </p>
    <div class="stage-legend">
      {Object.values(noteStageInfo).map((info) => (
        <span class="stage-item" title={info.description}>
          <span class="stage-icon">{info.icon}</span>
          <span class="stage-label">{info.label}</span>
        </span>
      ))}
    </div>
  </section>

  <div class="notes-toolbar">
    <nav class="filter-panel" aria-label="Filter by topic">
      <h3 class="filter-panel__title">Topics</h3>
      <div class="filter-pills filter-pills--scroll" id="topic-chips">
        <button type="button" class="filter-pill active" data-tag="all" aria-pressed="true">All topics</button>
        {allTags.map((tag) => (
          <button type="button" class="filter-pill" data-tag={tag} aria-pressed="false">
            {tag}
          </button>
        ))}
      </div>
    </nav>

    <nav class="filter-panel" aria-label="Filter by note stage">
      <h3 class="filter-panel__title">Stage</h3>
      <div class="filter-pills" id="stage-chips">
        <button type="button" class="filter-pill active" data-stage="all" aria-pressed="true">All stages</button>
        {NOTE_STAGE_VALUES.map((s) => (
          <button type="button" class="filter-pill" data-stage={s} aria-pressed="false">
            <span class="filter-pill__glyph" aria-hidden="true">{noteStageInfo[s].icon}</span>
            {noteStageInfo[s].label}
          </button>
        ))}
      </div>
    </nav>

    <div class="notes-search-row">
      <div class="notes-search-wrap">
        <SearchInput id="notes-search" label="Search notes" placeholder="Search notes…" />
      </div>
      <p class="notes-results-count" id="notes-results-count" role="status" aria-live="polite" aria-atomic="true">{notes.length} {notes.length === 1 ? 'note' : 'notes'}</p>
    </div>
  </div>

  <div class="notes-grid index-card-grid" id="notes-grid">
    {notes.length === 0 ? (
      <p class="empty-state">No notes yet. Check back soon!</p>
    ) : (
      notes.map((note, index) => {
        const stageKey = resolveNoteStage(note.data.stage);
        const stage = noteStageInfo[stageKey];
        const tags = note.data.tags || [];
        const cover = note.data.coverImage || notesPlaceholderSketch;
        const isSpotlight = index === 0;
        const sortDate = note.data.updatedDate || note.data.pubDate;
        const primaryTag = tags[0];

        return (
          <ContentIndexCard
            href={`/notes/${note.id}`}
            title={note.data.title}
            description={note.data.description}
            date={sortDate}
            imageSrc={cover}
            imageAlt={note.data.coverImage ? `Cover image for ${note.data.title}` : ''}
            primaryTag={primaryTag}
            tags={tags}
            spotlight={isSpotlight}
            heading={isSpotlight ? 'h2' : 'h3'}
            loading={isSpotlight ? 'eager' : 'lazy'}
            stage={`${stage.icon} ${stage.label}`}
            stageTitle={stage.description}
            stageKey={stageKey}
            filterTags={tags.join(',')}
            filterItem
          />
        );
      })
    )}
  </div>
  <div class="no-results" id="notes-no-results" hidden>
    <p>No notes match your filters.</p>
    <button type="button" class="btn btn-secondary" id="notes-reset-filters">Clear filters</button>
  </div>
</MainLayout>

<style>
  .notes-intro {
    max-width: var(--container-max-width, 72rem);
    margin: 0 auto calc(var(--spacing-xl) + var(--spacing-sm));
    padding: 0 var(--content-padding, 1.25rem);
  }

  .notes-intro__lede {
    font-size: 1.1875rem;
    line-height: 1.6;
    letter-spacing: var(--letter-spacing-body, 0.005em);
    color: var(--color-muted);
    margin: 0 0 var(--spacing-lg);
    max-width: 48rem;
  }

  .notes-intro__lede a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .notes-intro__rss {
    white-space: nowrap;
  }

  .stage-legend {
    display: flex;
    gap: calc(var(--spacing-md) + var(--spacing-xs));
    flex-wrap: wrap;
  }

  .stage-item {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--spacing-xs) + calc(var(--spacing-xs) - 0.125rem));
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .stage-icon {
    color: var(--color-muted);
  }

  .stage-label {
    font-weight: 500;
  }

  .notes-toolbar {
    max-width: var(--container-max-width, 72rem);
    margin: 0 auto var(--spacing-xl);
    padding: 0 var(--content-padding, 1.25rem);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .filter-pill__glyph {
    font-size: 0.875rem;
    opacity: 0.85;
    margin-right: calc(var(--spacing-xs) + 0.1rem);
  }

  .filter-pill.active .filter-pill__glyph {
    opacity: 1;
  }

  .notes-search-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-sm) var(--spacing-md);
  }

  .notes-search-wrap {
    flex: 1 1 18rem;
    min-width: 0;
    max-width: 24rem;
  }

  .notes-search-wrap :global(.search-wrapper) {
    margin-bottom: 0;
  }

  .notes-results-count {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .notes-grid {
    max-width: var(--container-max-width, 72rem);
    margin: 0 auto;
    padding: 0 var(--content-padding) var(--spacing-2xl);
  }

  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    color: var(--color-muted);
    padding: var(--spacing-2xl);
  }

  .no-results {
    text-align: center;
    color: var(--color-muted);
    padding: var(--spacing-xl) var(--content-padding);
    font-size: 0.9375rem;
  }

  .no-results[hidden] {
    display: none;
  }

  .no-results p {
    margin-bottom: var(--spacing-md);
  }

  @media (max-width: 768px) {
    .notes-intro__lede {
      font-size: 1.0625rem;
      line-height: 1.6;
    }
  }
</style>

<script>
  function initNotesFilters() {
    const grid = document.getElementById('notes-grid');
    if (!grid || grid.dataset.initialized === 'true') return;
    grid.dataset.initialized = 'true';
    const tagBtns = document.querySelectorAll('#topic-chips .filter-pill[data-tag]');
    const stageBtns = document.querySelectorAll('#stage-chips .filter-pill[data-stage]');
    const noteCards = document.querySelectorAll('.index-card[data-filter-item]');
    const searchInput = document.getElementById('notes-search') as HTMLInputElement;
    const noResults = document.getElementById('notes-no-results');
    const resultCount = document.getElementById('notes-results-count');
    const resetButton = document.getElementById('notes-reset-filters');
    const clearBtn = searchInput?.parentElement?.querySelector('.search-clear') as HTMLElement;

    let activeTag = 'all';
    let activeStage = 'all';

    function applyFilters() {
      const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
      let visibleCount = 0;

      tagBtns.forEach((btn) => {
        const active = btn.getAttribute('data-tag') === activeTag;
        btn.classList.toggle('active', active);
        btn.setAttribute('aria-pressed', String(active));
      });
      stageBtns.forEach((btn) => {
        const active = btn.getAttribute('data-stage') === activeStage;
        btn.classList.toggle('active', active);
        btn.setAttribute('aria-pressed', String(active));
      });

      if (clearBtn) {
        clearBtn.style.display = query ? 'flex' : 'none';
      }

      noteCards.forEach((card) => {
        const cardTags = card.getAttribute('data-tags') || '';
        const cardStage = card.getAttribute('data-stage') || 'thoughts';
        const title = card.getAttribute('data-title') || '';
        const description = card.getAttribute('data-description') || '';

        const tagList = cardTags ? cardTags.split(',') : [];
        const matchesTag =
          activeTag === 'all' || tagList.includes(activeTag);
        const matchesStage = activeStage === 'all' || cardStage === activeStage;
        const matchesSearch =
          !query || title.includes(query) || description.includes(query);

        const visible = matchesTag && matchesStage && matchesSearch;
        (card as HTMLElement).style.display = visible ? '' : 'none';
        if (visible) visibleCount++;
      });

      if (noResults) {
        noResults.hidden = visibleCount > 0 || noteCards.length === 0;
      }
      if (resultCount) resultCount.textContent = `${visibleCount} ${visibleCount === 1 ? 'note' : 'notes'}`;
    }

    tagBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeTag = btn.getAttribute('data-tag') || 'all';
        applyFilters();
      });
    });

    stageBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeStage = btn.getAttribute('data-stage') || 'all';
        applyFilters();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', applyFilters);
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
          applyFilters();
          searchInput.focus();
        }
      });
    }

    resetButton?.addEventListener('click', () => {
      activeTag = 'all';
      activeStage = 'all';
      searchInput.value = '';
      applyFilters();
      searchInput.focus();
    });
    applyFilters();
  }

  initNotesFilters();
  document.addEventListener('astro:page-load', initNotesFilters);
</script>
