---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="404 — Page not found" description="The page you're looking for doesn't exist." hideFooter={true}>
  <div class="not-found">
    <div class="error-code" aria-hidden="true">
      <span class="digit" style="--i:0">4</span>
      <span class="digit" style="--i:1">0</span>
      <span class="digit" style="--i:2">4</span>
    </div>
    <h1 class="text-heading">Page not found</h1>
    <p class="message text-muted">The page you're looking for doesn't exist or has been moved.</p>
    <nav class="suggestions" aria-label="Suggested pages">
      <a href="/notes">Notes</a>
      <a href="/works">Works</a>
      <a href="/featured">Featured</a>
    </nav>
    <button type="button" class="cmd-hint text-caption" data-open-command-palette>
      Or press <kbd>⌘</kbd><kbd>K</kbd> to search
    </button>
  </div>

  <style>
    .not-found {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      min-height: 70vh;
      padding: var(--spacing-xl) var(--spacing-md);
    }

    .error-code {
      display: flex;
      gap: 0;
      font-size: clamp(7rem, 18vw, 12rem);
      font-weight: 700;
      line-height: 1;
      margin: 0;
      color: var(--color-muted);
      letter-spacing: -0.04em;
      user-select: none;
    }

    .digit {
      display: inline-block;
      opacity: 0;
      animation: digitReveal var(--duration-slower) var(--ease-emphasized) forwards;
      animation-delay: calc(var(--i) * 0.08s + 0.1s);
    }

    @keyframes digitReveal {
      from {
        opacity: 0;
        transform: translateY(20px) scale(0.95);
        filter: blur(4px);
      }
      to {
        opacity: 0.12;
        transform: translateY(0) scale(1);
        filter: blur(0);
      }
    }

    h1 {
      font-size: clamp(1.5rem, 4vw, 2.25rem);
      font-weight: var(--heading-weight);
      margin: calc(-1 * var(--spacing-sm)) 0 var(--spacing-sm);
      letter-spacing: var(--letter-spacing-heading-lg);
      opacity: 0;
      animation: fadeUp var(--duration-slow) var(--ease-inertia) 0.35s forwards;
    }

    .message {
      font-size: var(--body-size);
      margin: 0 0 var(--spacing-xl);
      max-width: 36ch;
      line-height: 1.5;
      opacity: 0;
      animation: fadeUp var(--duration-slow) var(--ease-inertia) 0.45s forwards;
    }

    .suggestions {
      display: flex;
      gap: var(--spacing-sm);
      flex-wrap: wrap;
      justify-content: center;
      opacity: 0;
      animation: fadeUp var(--duration-slow) var(--ease-inertia) 0.55s forwards;
    }

    .suggestions a {
      color: var(--color-text);
      text-decoration: none;
      font-weight: 500;
      padding: var(--spacing-sm) calc(var(--spacing-md) + var(--spacing-xs));
      border: 1px solid var(--color-border);
      border-radius: var(--radius-full);
      font-size: 0.9rem;
      transition:
        background-color var(--duration-fast) var(--ease-standard),
        border-color var(--duration-fast) var(--ease-standard),
        color var(--duration-fast) var(--ease-standard),
        transform var(--duration-fast) var(--ease-standard);
    }

    .suggestions a::after {
      display: none;
    }

    @media (hover: hover) {
      .suggestions a:hover {
        background-color: var(--color-link);
        color: var(--color-bg);
        border-color: var(--color-link);
        transform: translateY(-1px);
      }
    }

    .suggestions a:focus-visible {
      outline: var(--focus-ring);
      outline-offset: var(--focus-ring-offset);
    }

    .cmd-hint {
      appearance: none;
      border: 0;
      background: none;
      color: var(--color-muted);
      cursor: pointer;
      margin-top: var(--spacing-xl);
      opacity: 0;
      animation: fadeUp var(--duration-slow) var(--ease-inertia) 0.65s forwards;
    }

    .cmd-hint:focus-visible {
      outline: var(--focus-ring);
      outline-offset: var(--focus-ring-offset);
    }

    kbd {
      display: inline-block;
      padding: calc(var(--spacing-xs) - 0.1rem) calc(var(--spacing-xs) + 0.15rem);
      font-size: 0.8em;
      font-family: inherit;
      line-height: 1;
      color: var(--color-muted);
      background: color-mix(in srgb, var(--color-text) 6%, transparent);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      box-shadow: 0 1px 0 color-mix(in srgb, var(--color-text) 8%, transparent);
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .digit,
      h1,
      .message,
      .suggestions,
      .cmd-hint {
        animation: none;
        opacity: 1;
      }
      .digit {
        opacity: 0.12;
      }
    }

    @media (max-width: 480px) {
      .not-found {
        min-height: 60vh;
      }

      .suggestions {
        gap: var(--spacing-sm);
      }

      .suggestions a {
        padding: calc(var(--spacing-xs) + 0.15rem) var(--spacing-md);
        font-size: 0.85rem;
      }
    }
  </style>
</MainLayout>
