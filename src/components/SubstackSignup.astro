---
interface Props {
  title?: string;
  description?: string;
  showTitle?: boolean;
  /** Set when this block is the sole newsletter region (avoids duplicate ids on example pages). */
  headingId?: string;
  /** Tighter typography and spacing (e.g. dedicated subscribe page). */
  compact?: boolean;
}

const {
  title = 'Proof of Concept',
  description = 'Get the weekly newsletter about design, technology, and experimentation.',
  showTitle = true,
  headingId,
  compact = false,
} = Astro.props;

const isBrandTitle = title === 'Proof of Concept';

const emailFieldId = headingId
  ? `${headingId.replace(/\s+/g, '-')}-email`
  : `poc-email-${Math.random().toString(36).slice(2, 11)}`;

const showHeader = showTitle || Boolean(description?.trim());
---

<div class:list={['substack-signup', { compact }]}>
  {
    showHeader && (
      <div class="signup-header">
        {showTitle && isBrandTitle && (
          <h2 class="signup-title signup-title--brand" id={headingId}>
            Proof of Concept
          </h2>
        )}
        {showTitle && !isBrandTitle && <h2 class="signup-title signup-title--custom" id={headingId}>{title}</h2>}
        {description && <p class="signup-description">{description}</p>}
      </div>
    )
  }

  <form
    action="https://www.proofofconcept.pub/api/v1/free"
    method="post"
    class="signup-form"
    data-substack-signup
  >
    <div class="signup-form-row">
      <div class="form-group">
        <div class="email-input-shell">
          <label for={emailFieldId} class="sr-only">Email for newsletter</label>
          <input
            type="email"
            id={emailFieldId}
            name="email"
            placeholder="you@example.com"
            required
            class="email-input"
            aria-label="Email address for newsletter signup"
            autocomplete="email"
            inputmode="email"
            autocapitalize="none"
            spellcheck="false"
          />
          <div class="email-input-rail" aria-hidden="true"></div>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="subscribe-button">
          <span class="subscribe-button-label">Subscribe</span>
          <span class="subscribe-button-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path
                d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </span>
        </button>
      </div>
    </div>
    <p class="sr-only" role="status" data-signup-status></p>
  </form>
</div>

<style>
  .substack-signup {
    container-type: inline-size;
    container-name: substack-signup;
    border-top: 1px solid var(--color-border);
    padding: var(--section-spacing) 0 var(--spacing-2xl);
    width: 100%;
  }

  .signup-header {
    margin-bottom: var(--spacing-xl);
  }

  .signup-title {
    margin: 0 0 calc(var(--spacing-sm) + var(--spacing-xs));
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.04em;
    line-height: 0.95;
  }

  .signup-title--brand {
    white-space: nowrap;
    font-size: clamp(1.45rem, min(5.4cqw + 0.45rem, 4.25vw + 1rem), 12rem);
  }

  .signup-title--custom {
    font-size: clamp(2rem, 8vw, 4rem);
    max-width: 20ch;
  }

  .signup-description {
    margin: 0;
    width: 100%;
    max-width: none;
    color: var(--color-muted);
    font-size: 1.15rem;
    line-height: 1.5;
  }

  .signup-form {
    width: 100%;
  }

  .signup-form-row {
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    gap: var(--spacing-md) calc(var(--spacing-md) + var(--spacing-xs));
    width: 100%;
  }

  .form-group {
    flex: 1;
    min-width: 0;
    width: auto;
  }

  .form-actions {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    flex-wrap: nowrap;
  }

  .email-input-shell {
    position: relative;
    width: 100%;
    min-width: 0;
  }

  .email-input {
    width: 100%;
    min-width: 0;
    padding: var(--spacing-sm) 0;
    border: none;
    border-radius: 0;
    font-size: clamp(1.35rem, min(2.65cqw + 0.65rem, 3.8vw), 3.35rem);
    font-family: var(--font-primary);
    font-weight: 600;
    letter-spacing: -0.02em;
    background: transparent;
    color: var(--color-text);
    transition: transform var(--duration-slower) var(--ease-spring);
    box-sizing: border-box;
  }

  .email-input-shell:focus-within .email-input {
    transform: translateY(-2px);
  }

  .email-input:focus {
    outline: none;
  }

  .email-input:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .email-input::placeholder {
    color: var(--color-muted);
    opacity: 1;
    font-weight: 600;
  }

  .email-input-rail {
    height: 4px;
    border-radius: 999px;
    margin-top: var(--spacing-xs);
    background: color-mix(in srgb, var(--color-border) 85%, transparent);
    position: relative;
    overflow: hidden;
  }

  .email-input-rail::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--color-link);
    transform: scaleX(0.15);
    transform-origin: left center;
    opacity: 0.45;
    transition:
      transform var(--duration-slower) var(--ease-emphasized),
      opacity var(--duration-slow) var(--ease-standard),
      background-color var(--duration-slow) var(--ease-standard);
  }

  .email-input-shell:focus-within .email-input-rail::after {
    transform: scaleX(1);
    opacity: 1;
    background: var(--color-link-hover);
  }

  .subscribe-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-md) var(--spacing-xl);
    background: var(--color-link);
    color: var(--color-bg);
    border: none;
    border-radius: 999px;
    font-size: 1.15rem;
    font-weight: 600;
    font-family: var(--font-primary);
    cursor: pointer;
    white-space: nowrap;
    transition:
      transform var(--duration-normal) var(--ease-spring),
      box-shadow var(--duration-normal) var(--ease-standard),
      background var(--duration-normal) var(--ease-standard);
    flex-shrink: 0;
    box-shadow: 0 4px 0 color-mix(in srgb, var(--color-text) 18%, transparent);
  }

  .subscribe-button-icon {
    display: flex;
    transition: transform var(--duration-slower) var(--ease-spring);
  }

  @media (hover: hover) {
    .subscribe-button:hover {
      background: var(--color-link-hover);
      transform: translateY(-3px) rotate(-1deg);
      box-shadow:
        0 8px 24px color-mix(in srgb, var(--color-link) 35%, transparent),
        0 6px 0 color-mix(in srgb, var(--color-text) 12%, transparent);
    }
  }

  @media (hover: hover) {
    .subscribe-button:hover .subscribe-button-icon {
      transform: translate(3px, -3px) rotate(12deg);
    }
  }

  [data-theme='dark'] .subscribe-button {
    box-shadow: 0 4px 0 color-mix(in srgb, var(--color-bg) 25%, transparent);
  }

  @media (hover: hover) {
    [data-theme='dark'] .subscribe-button:hover {
      box-shadow:
        0 8px 28px color-mix(in srgb, var(--color-link) 45%, transparent),
        0 6px 0 color-mix(in srgb, var(--color-bg) 18%, transparent);
    }
  }

  .subscribe-button:active {
    transform: translateY(0) rotate(0);
    box-shadow: 0 2px 0 color-mix(in srgb, var(--color-text) 15%, transparent);
  }

  .subscribe-button:active .subscribe-button-icon {
    transform: translate(1px, -1px);
  }

  .subscribe-button:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
  }

  .subscribe-button.is-loading {
    position: relative;
    color: transparent;
  }

  .subscribe-button.is-loading .subscribe-button-icon {
    opacity: 0;
  }

  .subscribe-button.is-loading::after {
    content: '';
    position: absolute;
    width: 18px;
    height: 18px;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    border: 2px solid var(--color-bg);
    border-top-color: transparent;
    border-radius: 50%;
    animation: btn-spin var(--duration-slowest) linear infinite;
  }

  @keyframes btn-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .subscribe-button:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .substack-signup.compact {
    padding: var(--spacing-lg) 0;
  }

  .substack-signup.compact .signup-title {
    font-size: 1.5rem;
    margin-bottom: var(--spacing-xs);
  }

  .substack-signup.compact .signup-title--brand {
    white-space: normal;
    font-size: 1.5rem;
    width: auto;
  }

  .substack-signup.compact .signup-description {
    font-size: 0.95rem;
    margin-bottom: var(--spacing-md);
  }

  .substack-signup.compact .email-input {
    font-size: 1.5rem;
  }

  .substack-signup.compact .signup-form-row {
    flex-direction: column;
    align-items: stretch;
  }

  .substack-signup.compact .subscribe-button {
    padding: calc(var(--spacing-sm) + var(--spacing-xs)) var(--spacing-lg);
    font-size: 1rem;
    box-shadow: none;
    width: 100%;
  }

  @media (hover: hover) {
    .substack-signup.compact .subscribe-button:hover {
      transform: translateY(-1px);
      box-shadow: var(--card-shadow);
    }
  }

  @media (max-width: 768px) {
    .substack-signup {
      padding: var(--spacing-2xl) 0 var(--spacing-xl);
    }

    .signup-title--brand {
      white-space: nowrap;
      font-size: clamp(1.2rem, 5.25vw + 0.65rem, 3.5rem);
    }

    .signup-form-row {
      flex-direction: column;
      align-items: stretch;
      gap: calc(var(--spacing-md) + var(--spacing-xs));
    }

    .form-actions {
      width: 100%;
    }

    .subscribe-button {
      width: 100%;
      justify-content: center;
    }

    .email-input {
      font-size: clamp(1.5rem, 6.5vw, 2.25rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .email-input,
    .subscribe-button,
    .subscribe-button-icon {
      transition: none;
    }

    .subscribe-button:hover,
    .subscribe-button:hover .subscribe-button-icon {
      transform: none;
    }

    .email-input-shell:focus-within .email-input {
      transform: none;
    }
  }
</style>

<script>
  import { reportAgentEvent } from '../scripts/agent-experience';
  import { buildNewsletterSubmitEvent } from '../utils/agentExperienceMetrics';

  function resetSignup(form: HTMLFormElement) {
    const button = form.querySelector<HTMLButtonElement>('.subscribe-button');
    button?.classList.remove('is-loading');
    if (button) button.disabled = false;
    form.removeAttribute('aria-busy');
    const status = form.querySelector<HTMLElement>('[data-signup-status]');
    if (status) status.textContent = '';
  }

  function initSignups() {
    document.querySelectorAll<HTMLFormElement>('form[data-substack-signup]').forEach((form) => {
      resetSignup(form);
      if (form.dataset.initialized === 'true') return;
      form.dataset.initialized = 'true';
      form.addEventListener('submit', () => {
        // Cross-origin POST navigates away; never include form values in analytics.
        reportAgentEvent(buildNewsletterSubmitEvent('attempted'));
        form.setAttribute('aria-busy', 'true');
        const status = form.querySelector<HTMLElement>('[data-signup-status]');
        if (status) status.textContent = 'Opening newsletter signup…';
        const button = form.querySelector<HTMLButtonElement>('.subscribe-button');
        button?.classList.add('is-loading');
        if (button) button.disabled = true;
      });
    });
  }

  initSignups();
  document.addEventListener('astro:page-load', initSignups);
  // Browser Back can restore the submitted form from the back/forward cache.
  window.addEventListener('pageshow', initSignups);
</script>
