---
import { footerBrand, footerSections } from '../data/navigation';
import { accessibleNameWithVisibleLabel } from '../utils/accessibleName';
---

<footer class="site-footer" role="contentinfo" aria-label="Site footer">
  <div class="container">
    <section class="footer-nav" aria-label="Footer navigation">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/" class="footer-logo" aria-label={accessibleNameWithVisibleLabel('DH', 'David Hoang homepage')}>DH</a>
          <p class="footer-tagline">{footerBrand.tagline}</p>
          <a href={footerBrand.emailHref} class="footer-link footer-email-link">Email me</a>
        </div>

        {footerSections.map((section) => (
          <nav class="footer-col" aria-label={section.title}>
            <details class="footer-col__details" open>
              <summary class="footer-col__heading">{section.title}</summary>
              <ul role="list">
                {section.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="footer-link"
                      aria-label={accessibleNameWithVisibleLabel(link.label, link.ariaLabel)}
                      target={link.external ? '_blank' : undefined}
                      rel={link.external ? 'noopener noreferrer' : undefined}
                    >
                      {link.label}
                      {link.external && (
                        <span class="footer-external" aria-hidden="true">↗</span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </nav>
        ))}
      </div>
    </section>
  </div>
</footer>

<script>
  // Markup starts with open so desktop always shows links (no JS dependency /
  // no FOUC). Collapse on mobile for the accordion pattern.
  const footerDetails = document.querySelectorAll('.footer-col__details');
  const desktopNav = window.matchMedia('(min-width: 768px)');

  const syncFooterDetails = () => {
    footerDetails.forEach((el) => {
      if (desktopNav.matches) el.setAttribute('open', '');
      else el.removeAttribute('open');
    });
  };

  syncFooterDetails();
  desktopNav.addEventListener('change', syncFooterDetails);
</script>
