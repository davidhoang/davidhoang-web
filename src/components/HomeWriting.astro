---
import type { CollectionEntry } from 'astro:content';
import { formatListDate } from '../utils/formatDate';
import { getWritingPostHero } from '../utils/writingPostImage';

interface Props { posts: CollectionEntry<'writing'>[] }
const { posts } = Astro.props;
const [latest, ...more] = posts;
const image = latest ? getWritingPostHero({ ...latest.data, body: latest.body }) : undefined;
---

<section id="latest-writing" class="home-writing home-content-start" aria-labelledby="latest-writing-heading">
  <div class="home-section-header">
    <h2 id="latest-writing-heading" class="home-section-heading text-heading">Latest writing</h2>
    <a href="/writing" class="home-section-link">All writing <span aria-hidden="true">↗</span></a>
  </div>
  {latest ? (
    <>
      <article class="home-writing__lead">
        <a class="home-writing__image link-plain" href={`/writing/${latest.id}`} tabindex="-1" aria-hidden="true">
          <img src={image} alt="" width="800" height="500" loading="lazy" decoding="async" />
        </a>
        <div class="home-writing__copy">
          <time datetime={latest.data.pubDate.toISOString()}>{formatListDate(latest.data.pubDate)}</time>
          <h3><a href={`/writing/${latest.id}`}>{latest.data.title}</a></h3>
          {latest.data.description && <p>{latest.data.description}</p>}
        </div>
      </article>
      {more.length > 0 && (
        <ul class="home-writing__more">
          {more.map(post => (
            <li>
              <time datetime={post.data.pubDate.toISOString()}>{formatListDate(post.data.pubDate)}</time>
              <h3><a href={`/writing/${post.id}`}>{post.data.title}</a></h3>
            </li>
          ))}
        </ul>
      )}
    </>
  ) : <p>Essays on design, technology, and building products. <a href="/writing">Explore the archive</a>.</p>}
</section>

<style>
  .home-writing__lead {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--spacing-xl);
    align-items: center;
  }

  .home-writing__image {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-sidebar-bg);
  }

  .home-writing__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .home-writing__image img[src^='/api/og'] {
    object-fit: contain;
  }

  .home-writing__copy {
    min-width: 0;
  }

  time {
    font-size: 0.875rem;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  h3 {
    margin: var(--spacing-sm) 0;
    font-family: var(--font-heading);
    font-weight: var(--heading-weight);
    line-height: 1.2;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .home-writing__lead h3 {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
  }

  .home-writing__copy p {
    margin: var(--spacing-md) 0 0;
    color: var(--color-muted);
    font-size: var(--body-size);
    line-height: var(--body-line-height);
    text-wrap: pretty;
  }

  .home-writing__more {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-xl);
    list-style: none;
    padding: var(--spacing-lg) 0 0;
    margin: var(--spacing-xl) 0 0;
    border-top: 1px solid var(--color-border);
  }

  .home-writing__more li {
    min-width: 0;
    margin: 0;
    padding: 0;
  }

  .home-writing__more h3 {
    font-size: var(--h3-size);
  }

  @media (max-width: 768px) {
    .home-writing__lead,
    .home-writing__more {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }
  }
</style>
