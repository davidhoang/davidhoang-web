---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: Heading[];
  /** full: TOC + meta (default). toc-only: right-column TOC. meta-only: newsletter + links below article body. sidebar: sticky TOC + meta in one right column. toc-left: subtle left-column TOC (writing posts). meta-sidebar: sticky right-column meta only (writing posts). */
  variant?: 'full' | 'toc-only' | 'meta-only' | 'sidebar' | 'toc-left' | 'meta-sidebar';
}

const { headings = [], variant = 'full' } = Astro.props;
/** H1–H3 from article body (depth 1–3 in markdown). */
const tocHeadings = headings.filter((h) => h.depth >= 1 && h.depth <= 3);
const hasHeadings = tocHeadings.length > 0;

const showToc =
  (variant === 'full' ||
    variant === 'toc-only' ||
    variant === 'sidebar' ||
    variant === 'toc-left') &&
  hasHeadings;
const showMeta =
  variant === 'full' ||
  variant === 'meta-only' ||
  variant === 'sidebar' ||
  variant === 'meta-sidebar';

const useStickyPanel =
  variant === 'toc-only' ||
  variant === 'sidebar' ||
  variant === 'toc-left' ||
  variant === 'meta-sidebar';

const showAside =
  variant === 'meta-only' ||
  variant === 'full' ||
  variant === 'sidebar' ||
  variant === 'meta-sidebar' ||
  variant === 'toc-left' ||
  (variant === 'toc-only' && hasHeadings);

/* TOC column: outer slot is not sticky (avoids grid height ~1 line); inner panel is sticky + card */
const asideClass = [
  'sidebar',
  'glass-border',
  variant === 'meta-only' && 'sidebar--meta-inline',
]
  .filter(Boolean)
  .join(' ');

const asideAria =
  variant === 'meta-only' || variant === 'meta-sidebar'
    ? 'Newsletter and social links'
    : variant === 'sidebar'
      ? 'Table of contents and links'
      : variant === 'toc-left' || variant === 'toc-only'
        ? 'Table of contents'
        : 'Sidebar with additional information';

const stickySlotClass = [
  'sidebar-toc-slot',
  variant === 'sidebar' && 'writing-sidebar-slot',
  variant === 'meta-sidebar' && 'writing-meta-sidebar-slot',
]
  .filter(Boolean)
  .join(' ');
---

{
  showAside &&
    (variant === 'toc-left' ? (
      <aside class="writing-toc-left" role="navigation" aria-label="Table of contents">
        <div class="writing-toc-left__inner">
          <p class="writing-toc-left__label">Table of Contents</p>
          <ul class="toc-list writing-toc-left__list" role="list">
            {tocHeadings.map((heading) => (
              <li class:list={['toc-item', `toc-item--depth-${heading.depth}`]}>
                <a href={`#${heading.slug}`} class="toc-link writing-toc-left__link" data-heading-slug={heading.slug}>
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    ) : useStickyPanel ? (
      <aside class={stickySlotClass} role="complementary" aria-label={asideAria}>
        <div
          class:list={['sidebar-toc-panel', variant === 'meta-sidebar' && 'writing-meta-sidebar__panel']}
          role={showToc ? 'navigation' : undefined}
          aria-label={showToc ? 'Table of contents' : undefined}
        >
          {showToc && (
            <>
              <h2 class="toc-heading">Table of Contents</h2>
              <ul class="toc-list" role="list">
                {tocHeadings.map((heading) => (
                  <li class:list={['toc-item', `toc-item--depth-${heading.depth}`]}>
                    <a href={`#${heading.slug}`} class="toc-link" data-heading-slug={heading.slug}>
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )}

          {showMeta && (
            <>
              <div class:list={['sidebar-section', showToc && 'sidebar-section--after-toc']}>
                <h2>Newsletter</h2>
                <p>Subscribe to my newsletter Proof of Concept, sent every Sunday.</p>
                <a
                  href="https://www.proofofconcept.pub/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="sidebar-button glass-border-button"
                  aria-label="Subscribe to Proof of Concept newsletter"
                >
                  Subscribe →
                </a>
              </div>

              <div class="sidebar-section">
                <h2>Elsewhere</h2>
                <ul class="social-links" role="list" aria-label="Social media and other links">
                  <li><a href="https://twitter.com/davidhoang" target="_blank" rel="noopener noreferrer">Twitter</a></li>
                  <li><a href="https://github.com/davidhoang" target="_blank" rel="noopener noreferrer">GitHub</a></li>
                  <li><a href="https://linkedin.com/in/dhoang2" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
                  <li><a href="/rss.xml" target="_blank" aria-label="Writing RSS feed">Writing RSS</a></li>
                </ul>
              </div>
            </>
          )}
        </div>
      </aside>
    ) : (
      <aside class={asideClass} role="complementary" aria-label={asideAria}>
        {showToc && (
          <nav class="sidebar-section toc-section" aria-label="Table of contents">
            <h2>Table of Contents</h2>
            <ul class="toc-list" role="list">
              {tocHeadings.map((heading) => (
                <li class:list={['toc-item', `toc-item--depth-${heading.depth}`]}>
                  <a href={`#${heading.slug}`} class="toc-link" data-heading-slug={heading.slug}>
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        {showMeta && (
          <>
            <div class="sidebar-section">
              <h2>Newsletter</h2>
              <p>Subscribe to my newsletter Proof of Concept, sent every Sunday.</p>
              <a
                href="https://www.proofofconcept.pub/"
                target="_blank"
                rel="noopener noreferrer"
                class="sidebar-button glass-border-button"
                aria-label="Subscribe to Proof of Concept newsletter"
              >
                Subscribe →
              </a>
            </div>

            <div class="sidebar-section">
              <h2>Elsewhere</h2>
              <ul class="social-links" role="list" aria-label="Social media and other links">
                <li><a href="https://twitter.com/davidhoang" target="_blank" rel="noopener noreferrer">Twitter</a></li>
                <li><a href="https://github.com/davidhoang" target="_blank" rel="noopener noreferrer">GitHub</a></li>
                <li><a href="https://linkedin.com/in/dhoang2" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
                <li><a href="/rss.xml" target="_blank" aria-label="Writing RSS feed">Writing RSS</a></li>
              </ul>
            </div>
          </>
        )}
      </aside>
    ))
}

<script>
  function initSidebar() {
    initTocScrollSpy();
  }

  function initTocScrollSpy() {
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
    if (tocLinks.length === 0) return;

    const headingElements: HTMLElement[] = [];
    tocLinks.forEach((link) => {
      const slug = link.dataset.headingSlug;
      if (slug) {
        const el = document.getElementById(slug);
        if (el) headingElements.push(el);
      }
    });

    if (headingElements.length === 0) return;

    function updateActiveHeading() {
      const scrollY = window.scrollY;
      const offset = 120;

      let activeSlug = headingElements[0]?.id;
      for (const heading of headingElements) {
        if (heading.offsetTop - offset <= scrollY) {
          activeSlug = heading.id;
        } else {
          break;
        }
      }

      tocLinks.forEach((link) => {
        if (link.dataset.headingSlug === activeSlug) {
          link.classList.add('active');
        } else {
          link.classList.remove('active');
        }
      });
    }

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    tocLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const slug = link.dataset.headingSlug;
        if (!slug) return;
        const target = document.getElementById(slug);
        if (target) {
          const behavior = reduceMotion.matches ? 'auto' : 'smooth';
          target.scrollIntoView({ behavior, block: 'start' });
          history.pushState(null, '', `#${slug}`);
        }
      });
    });

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          updateActiveHeading();
          ticking = false;
        });
        ticking = true;
      }
    });

    updateActiveHeading();
  }

  document.addEventListener('astro:page-load', initSidebar);
</script>

<style>
  /* TOC sidebar: aside stretches with the grid row for sticky to work */
  .sidebar-toc-slot {
    align-self: stretch;
    min-width: 0;
    justify-self: end;
  }

  /* TOC card: sticky + card styles on one element */
  .sidebar-toc-panel {
    position: sticky;
    top: calc(var(--nav-offset-top, 24px) + var(--nav-height, 48px) + 1.5rem);
    z-index: 2;
    width: 100%;
    max-width: 250px;
    padding: calc(var(--spacing-md) + var(--spacing-xs)) calc(var(--spacing-md) + var(--spacing-xs)) calc(var(--spacing-md) + var(--spacing-xs)) var(--spacing-lg);
    box-sizing: border-box;
    background-color: var(--color-sidebar-bg);
    border: var(--border-default);
    border-radius: var(--radius-lg);
  }

  @media (min-width: 1024px) {
    .sidebar-toc-panel {
      max-width: min(17.5rem, 100%);
    }
  }

  @media (min-width: 1280px) {
    .sidebar-toc-panel {
      max-width: min(18.75rem, 100%);
    }
  }

  @media (min-width: 1536px) {
    .sidebar-toc-panel {
      max-width: min(19.5rem, 100%);
    }
  }

  .toc-heading {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin: 0 0 calc(var(--spacing-sm) + var(--spacing-xs)) 0;
    color: var(--color-muted);
  }

  .sidebar {
    float: none;
    clear: none;
    align-self: start;
    justify-self: end;
    width: 100%;
    max-width: 250px;
    height: auto;
    /* At least as tall as all sections (flex column; avoids collapsed min-content quirks) */
    min-height: max-content;
    max-height: none;
    padding: calc(var(--spacing-md) + var(--spacing-xs)) calc(var(--spacing-md) + var(--spacing-xs)) calc(var(--spacing-md) + var(--spacing-xs)) var(--spacing-lg);
    box-sizing: border-box;
    background-color: var(--color-sidebar-bg);
    border: var(--border-default);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    /* visible on both axes: hidden+visible forces y=auto and can collapse height with min-height:0 */
    overflow: visible;
    scrollbar-width: none;
    isolation: isolate;
  }

  .sidebar::-webkit-scrollbar {
    display: none;
  }

  /* Newsletter + links below article (main column; never sticky) */
  .sidebar--meta-inline {
    position: static;
    justify-self: start;
    width: 100%;
    max-width: min(100%, 20rem);
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .sidebar-section--after-toc {
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    margin-top: 0.25rem;
  }

  .sidebar-section {
    margin-bottom: 1.25rem;
    flex-shrink: 0;
  }

  .sidebar-section:last-child {
    margin-bottom: 0;
  }

  .sidebar-section h2 {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin: 0 0 calc(var(--spacing-sm) + var(--spacing-xs)) 0;
    color: var(--color-muted);
  }

  .sidebar-section p {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--color-muted);
    margin: 0 0 calc(var(--spacing-md) - calc(var(--spacing-xs) - 0.1rem)) 0;
  }

  /* Table of contents: H1–H3 list, no scroll containers, no scrollbars */
  .toc-section {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 1rem;
    flex-shrink: 0;
    overflow: visible;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .toc-section::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    overflow: visible;
    scrollbar-width: none;
  }

  .toc-list::-webkit-scrollbar {
    display: none;
  }

  .toc-item {
    margin-bottom: 0.125rem;
  }

  .toc-item--depth-2 {
    padding-left: 0.625rem;
  }

  .toc-item--depth-3 {
    padding-left: 1.25rem;
  }

  .writing-toc-left__list .toc-item--depth-2 {
    padding-left: 0.5rem;
  }

  .writing-toc-left__list .toc-item--depth-3 {
    padding-left: 1rem;
  }

  .toc-link {
    display: block;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    padding: calc(var(--spacing-xs) + 0.15rem) var(--spacing-sm);
    font-size: 0.8125rem;
    line-height: 1.4;
    overflow-wrap: anywhere;
    word-break: break-word;
    color: var(--color-muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    border-bottom: none;
    /* Inner radius ≈ outer (--radius-lg) minus horizontal inset (padding + link pad) */
    border-radius: max(0px, calc(var(--radius-lg) - 1.25rem));
    transition:
      color var(--duration-normal, 0.2s) ease,
      border-color var(--duration-normal, 0.2s) ease,
      background-color var(--duration-normal, 0.2s) ease;
  }

  .toc-link::after {
    display: none;
  }

  .toc-link:hover {
    color: var(--color-text);
    text-decoration: none;
    background: color-mix(in srgb, var(--color-text) 5%, transparent);
  }

  .toc-link.active {
    color: var(--color-text);
    font-weight: 500;
    /* Real border spans full multi-line block; inset box-shadow clipped oddly on wrapped text */
    border-left-color: var(--color-link);
    background: color-mix(in srgb, var(--color-text) 8%, transparent);
  }

  .category-list,
  .social-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .category-list li,
  .social-links li {
    margin-bottom: 0.25rem;
  }

  .category-list a,
  .social-links a {
    color: var(--color-link);
    text-decoration: none;
    font-size: 0.8125rem;
    border-bottom: none;
  }

  .category-list a::after,
  .social-links a::after {
    display: none;
  }

  .category-list a:hover,
  .social-links a:hover {
    color: var(--color-link-hover);
  }

  .sidebar-button {
    display: inline-block;
    padding: calc(var(--spacing-sm) - calc(var(--spacing-xs) - 0.2rem)) calc(var(--spacing-md) - var(--spacing-xs));
    background-color: var(--color-link);
    color: var(--color-bg);
    text-decoration: none;
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    font-weight: 500;
    border-bottom: none;
    transition: background var(--duration-normal, var(--duration-normal)) ease, transform var(--duration-normal, var(--duration-normal)) ease;
  }

  .sidebar-button::after {
    display: none;
  }

  @media (hover: hover) {
    .sidebar-button:hover {
      background-color: var(--color-link-hover);
      color: var(--color-bg);
      text-decoration: none;
      transform: translateY(-1px);
    }
  }

  @media (max-width: 768px) {
    /* Right-column TOC hidden on index layouts — keep combined writing sidebar visible */
    .sidebar-toc-slot:not(.writing-sidebar-slot):not(.writing-meta-sidebar-slot) {
      display: none !important;
    }

    .writing-toc-left {
      display: none;
    }

    .writing-meta-sidebar-slot .sidebar-toc-panel {
      position: static;
      max-width: 100%;
    }

    .writing-sidebar-slot .toc-list {
      display: none;
    }

    .writing-sidebar-slot .toc-heading {
      display: none;
    }

    .sidebar {
      position: static;
      width: 100%;
      max-height: none;
      overflow: visible;
      display: block;
      margin-top: 2rem;
      padding: calc(var(--spacing-md) + var(--spacing-xs));
    }

    .sidebar--meta-inline {
      margin-top: 2rem;
      padding-top: 1.75rem;
      max-width: 100%;
    }

    .toc-section {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .sidebar {
      padding: var(--spacing-md);
      margin: var(--spacing-md) 0;
    }

    .writing-meta-sidebar-slot .sidebar-toc-panel {
      padding: var(--spacing-md);
    }
  }

  /* Left-column TOC — text-only, no card (writing posts) */
  .writing-toc-left {
    align-self: stretch;
    min-width: 0;
    justify-self: end;
  }

  .writing-toc-left__inner {
    position: sticky;
    top: calc(var(--nav-offset-top, 24px) + var(--nav-height, 48px) + 1.5rem);
    z-index: 2;
    padding-top: 0.25rem;
    text-align: right;
  }

  .writing-toc-left__label {
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0 0 calc(var(--spacing-sm) + var(--spacing-xs) / 2);
    color: var(--color-muted);
    opacity: 0.85;
  }

  .writing-toc-left__list {
    border: none;
  }

  .writing-toc-left__link {
    padding: 0.25rem 0;
    font-size: 0.75rem;
    line-height: 1.45;
    border-left: none;
    border-radius: 0;
    background: transparent;
    text-align: right;
  }

  .writing-toc-left__link:hover {
    background: transparent;
    color: var(--color-text);
  }

  .writing-toc-left__link.active {
    color: var(--color-text);
    font-weight: 500;
    background: transparent;
    border-left: none;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-link) 45%, transparent);
    text-underline-offset: 0.2em;
  }

  /* Right-column meta sidebar (writing posts) */
  .writing-meta-sidebar-slot {
    align-self: stretch;
    min-width: 0;
    justify-self: end;
  }

  .writing-meta-sidebar__panel {
    max-width: 100%;
  }
</style>
