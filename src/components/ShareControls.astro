---
interface Props {
  url: string;
  title: string;
  description?: string;
}

const { url, title, description = '' } = Astro.props;
---

<div
  class="share-controls"
  data-share-controls
  data-share-url={url}
  data-share-title={title}
  data-share-description={description}
>
  <button type="button" class="btn btn-secondary btn-sm share-copy" data-share-copy data-copy-state="idle" aria-label="Copy link">
    <span class="share-copy__labels" aria-hidden="true">
      <span data-copy-label="idle">Copy link</span>
      <span data-copy-label="pending">Copying…</span>
      <span data-copy-label="copied">Copied</span>
    </span>
    <span class="share-copy__check" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4 4 10-10" /></svg>
    </span>
  </button>
  <button type="button" class="btn btn-secondary btn-sm" data-share-native hidden>Share</button>
  <span class="share-status" role="status" aria-live="polite" data-share-status></span>
</div>

<script>
  async function copyText(value: string): Promise<void> {
    if (!navigator.clipboard?.writeText) {
      throw new Error('Clipboard API is not available');
    }
    await navigator.clipboard.writeText(value);
  }

  function initShareControls() {
    document.querySelectorAll<HTMLElement>('[data-share-controls]').forEach((root) => {
      if (root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';

      const copyButton = root.querySelector<HTMLButtonElement>('[data-share-copy]');
      const shareButton = root.querySelector<HTMLButtonElement>('[data-share-native]');
      const status = root.querySelector<HTMLElement>('[data-share-status]');
      const url = root.dataset.shareUrl || window.location.href;
      const title = root.dataset.shareTitle || document.title;
      const text = root.dataset.shareDescription || undefined;

      let resetTimer: ReturnType<typeof setTimeout> | undefined;
      copyButton?.addEventListener('click', async () => {
        if (copyButton.disabled) return;
        clearTimeout(resetTimer);
        copyButton.disabled = true;
        copyButton.dataset.copyState = 'pending';
        copyButton.setAttribute('aria-label', 'Copying link');
        if (status) status.textContent = '';
        try {
          await copyText(url);
          copyButton.dataset.copyState = 'copied';
          copyButton.setAttribute('aria-label', 'Link copied');
          if (status) status.textContent = 'Link copied to clipboard';
          resetTimer = setTimeout(() => {
            copyButton.dataset.copyState = 'idle';
            copyButton.setAttribute('aria-label', 'Copy link');
            if (status) status.textContent = '';
          }, 2000);
        } catch {
          copyButton.dataset.copyState = 'idle';
          copyButton.setAttribute('aria-label', 'Copy link');
          if (status) status.textContent = 'Couldn’t copy. Copy the address from your browser.';
        } finally {
          copyButton.disabled = false;
        }
      });

      if (shareButton && typeof navigator.share === 'function') {
        shareButton.hidden = false;
        shareButton.addEventListener('click', async () => {
          try {
            await navigator.share({ title, text, url });
          } catch (error) {
            if (error instanceof DOMException && error.name === 'AbortError') return;
            if (status) status.textContent = 'Unable to open sharing';
          }
        });
      }
    });
  }

  initShareControls();
  if (!(window as any).__shareControlsPageLoadBound) {
    (window as any).__shareControlsPageLoadBound = true;
    document.addEventListener('astro:page-load', initShareControls);
  }
</script>

<style>
  .share-controls {
    position: relative;
    padding-bottom: var(--spacing-xl);
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    align-items: center;
    flex-shrink: 0;
    margin-inline-start: auto;
  }

  .share-controls .btn {
    font-size: 0.75rem;
    line-height: 1.25;
    padding: calc(var(--spacing-xs) * 0.75) var(--spacing-sm);
    gap: var(--spacing-xs);
    font-weight: 500;
  }
  .share-copy__labels {
    display: grid;
  }

  .share-copy__labels > span {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-standard);
  }

  [data-copy-state="idle"] [data-copy-label="idle"],
  [data-copy-state="pending"] [data-copy-label="pending"],
  [data-copy-state="copied"] [data-copy-label="copied"] {
    opacity: 1;
  }

  .share-copy__check {
    display: inline-flex;
    opacity: 0;
    transform: scale(0.8);
    transition:
      opacity var(--duration-fast) var(--ease-standard),
      transform var(--duration-normal) var(--ease-emphasized);
  }

  [data-copy-state="copied"] .share-copy__check {
    opacity: 1;
    transform: scale(1);
  }

  .share-status {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% - var(--spacing-xl) + var(--spacing-xs));
    inline-size: max-content;
    max-inline-size: min(40ch, calc(100vw - var(--spacing-2xl)));
    text-align: end;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--color-muted);
  }

  .share-copy:active {
    transform: scale(0.98);
  }

  @media (prefers-reduced-motion: reduce) {
    .share-copy__labels > span,
    .share-copy__check {
      transition: none;
      transform: none;
    }

    .share-copy:active {
      transform: none;
    }
  }
</style>
