---
interface Props {
  url: string;
  title: string;
  description?: string;
}

const { url, title, description = '' } = Astro.props;
---

<div
  class="share-controls"
  data-share-controls
  data-share-url={url}
  data-share-title={title}
  data-share-description={description}
>
  <button type="button" class="btn btn-ghost btn-sm" data-share-copy>Copy link</button>
  <button type="button" class="btn btn-ghost btn-sm" data-share-native hidden>Share</button>
  <span class="sr-only" role="status" aria-live="polite" data-share-status></span>
</div>

<script>
  async function copyText(value: string): Promise<void> {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(value);
      return;
    }

    const input = document.createElement('textarea');
    input.value = value;
    input.style.position = 'fixed';
    input.style.opacity = '0';
    document.body.appendChild(input);
    input.select();
    const copied = document.execCommand('copy');
    input.remove();
    if (!copied) throw new Error('Copy command failed');
  }

  function initShareControls() {
    document.querySelectorAll<HTMLElement>('[data-share-controls]').forEach((root) => {
      if (root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';

      const copyButton = root.querySelector<HTMLButtonElement>('[data-share-copy]');
      const shareButton = root.querySelector<HTMLButtonElement>('[data-share-native]');
      const status = root.querySelector<HTMLElement>('[data-share-status]');
      const url = root.dataset.shareUrl || window.location.href;
      const title = root.dataset.shareTitle || document.title;
      const text = root.dataset.shareDescription || undefined;

      copyButton?.addEventListener('click', async () => {
        try {
          await copyText(url);
          copyButton.textContent = 'Copied';
          if (status) status.textContent = 'Link copied to clipboard';
          window.setTimeout(() => {
            copyButton.textContent = 'Copy link';
          }, 2000);
        } catch {
          if (status) status.textContent = 'Unable to copy link';
        }
      });

      if (shareButton && typeof navigator.share === 'function') {
        shareButton.hidden = false;
        shareButton.addEventListener('click', async () => {
          try {
            await navigator.share({ title, text, url });
          } catch (error) {
            if (error instanceof DOMException && error.name === 'AbortError') return;
            if (status) status.textContent = 'Unable to open sharing';
          }
        });
      }
    });
  }

  initShareControls();
  if (!(window as any).__shareControlsPageLoadBound) {
    (window as any).__shareControlsPageLoadBound = true;
    document.addEventListener('astro:page-load', initShareControls);
  }
</script>

<style>
  .share-controls {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    align-items: center;
  }
</style>
