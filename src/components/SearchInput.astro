---
interface Props {
  id: string;
  placeholder?: string;
  label?: string;
}

const { id, placeholder = 'Search...', label = 'Search' } = Astro.props;
---

<div class="search-wrapper">
  <label for={id} class="sr-only">{label}</label>
  <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="11" r="8"/>
    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
  </svg>
  <input
    type="search"
    id={id}
    class="search-input"
    placeholder={placeholder}
    autocomplete="off"
    spellcheck="false"
  />
  <button class="search-clear" aria-label="Clear search" type="button" disabled>
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="18" y1="6" x2="6" y2="18"/>
      <line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>
</div>

<style>
  .search-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    margin-bottom: var(--spacing-lg);
  }

  .search-icon {
    position: absolute;
    left: calc(var(--spacing-sm) + var(--spacing-xs));
    color: var(--color-muted);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    min-height: 48px;
    padding: calc(var(--spacing-sm) + var(--spacing-xs)) var(--spacing-2xl) calc(var(--spacing-sm) + var(--spacing-xs)) calc(var(--spacing-xl) + var(--spacing-xs));
    font-family: var(--font-body, inherit);
    font-size: 1rem;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
    transition: border-color var(--duration-normal) var(--ease-standard);
  }

  .search-input:focus {
    outline: none;
    border-color: var(--color-link);
  }

  .search-input:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
    border-color: var(--color-link);
  }

  .search-clear:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .search-input::placeholder {
    color: var(--color-muted);
  }

  /* Hide browser-default clear button */
  .search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  .search-clear {
    position: absolute;
    right: var(--spacing-xs);
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    color: var(--color-muted);
    cursor: pointer;
    padding: var(--spacing-xs);
    display: flex;
    opacity: 0;
    visibility: hidden;
    transform: scale(0.9);
    transition:
      opacity var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-emphasized),
      visibility var(--duration-fast) var(--ease-standard);
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm, 4px);
  }

  .search-wrapper[data-has-query="true"] .search-clear {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
  }

  .search-clear:active {
    transform: scale(0.94);
  }

  @media (prefers-reduced-motion: reduce) {
    .search-clear {
      transition: none;
      transform: none;
    }

    .search-clear:active {
      transform: none;
    }
  }

  @media (hover: hover) {
    .search-clear:hover {
      color: var(--color-text);
      background: var(--color-sidebar-bg);
    }
  }
</style>

<script>
  function initSearchInputs() {
    document.querySelectorAll<HTMLElement>('.search-wrapper').forEach((root) => {
      const input = root.querySelector<HTMLInputElement>('.search-input');
      const clear = root.querySelector<HTMLButtonElement>('.search-clear');
      if (!input || !clear) return;
      const sync = () => {
        const hasQuery = input.value.length > 0;
        root.dataset.hasQuery = String(hasQuery);
        clear.disabled = !hasQuery;
      };
      sync();
      if (root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';
      input.addEventListener('input', sync);
      clear.addEventListener('click', () => {
        input.value = '';
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.focus({ preventScroll: true });
      });
    });
  }
  initSearchInputs();
  document.addEventListener('astro:page-load', initSearchInputs);
  window.addEventListener('pageshow', initSearchInputs);
</script>
